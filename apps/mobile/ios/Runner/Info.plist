<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Ascend</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Ascend</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Live GPS cardio (Founder Scenario 12) — requested with an in-app
	     explanation before this system prompt (see
	     apps/mobile/lib/features/cardio/data/live_location_service.dart).
	     Location is only ever used while a session is active, per
	     user-scenario-bible.md's "no tracking outside a session" rule. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Ascend uses your location only while you're recording a live cardio session, to track your route, distance, and pace. Your route stays private by default.</string>
	<!-- Build Session 9 Part 10 — a second, separate ask, made only once a
	     live cardio session has actually started: whether tracking may
	     keep going if you lock your phone or switch apps mid-session. If
	     declined, the session falls back to pausing when backgrounded,
	     same as before this key existed. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>If you allow it, Ascend can keep recording your route during a live cardio session even if you lock your phone or switch apps. This is only ever used while a session you started is in progress.</string>
	<!-- Media Platform (Build Session 8 Part 3) — requested only when you
	     choose to take a photo/video (a Community post, profile photo,
	     meal photo, progress photo, or Vision capture). Never runs in the
	     background. -->
	<key>NSCameraUsageDescription</key>
	<string>Ascend uses your camera only when you choose to take a photo or video — for a Community post, your profile, a meal or progress photo, or a Vision capture.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Ascend uses your microphone only when you choose to record a video with sound, or when you tap the mic to talk to your companion.</string>
	<!-- Atlas/Nova voice V1 (Build Session 9 Part 14) — separate from
	     NSMicrophoneUsageDescription above; iOS requires this key
	     specifically for on-device speech recognition (speech_to_text).
	     Requested only when the user taps the mic button in the companion
	     chat, a Premium feature — see companion_voice_controller.dart. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Ascend uses on-device speech recognition only when you tap the mic to talk to your companion instead of typing.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Ascend uses your photo library only when you choose to select an existing photo or video to attach.</string>
	<!-- Build Session 9 Part 10 — required for iOS to deliver location
	     updates while Ascend is backgrounded. Only takes effect for a
	     stream started with AppleSettings.allowBackgroundLocationUpdates,
	     which GeolocatorLiveLocationService only does for an active live
	     cardio session that was granted "Always" authorization; Ascend
	     never runs any other background work. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<!-- Remote push notifications (Build Session 11 Part 5) — lets iOS
		     wake the app to process a background push. Actually receiving
		     APNs pushes still requires the Push Notifications capability
		     (an entitlements file) tied to a real Apple Developer Program
		     team/App ID, which does not exist in this environment — see
		     build-session-11.md. -->
		<string>remote-notification</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
