<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Live GPS cardio (Founder Scenario 12) — location is only ever
         requested with an explanation before the OS prompt, and only
         while a session is active (see
         apps/mobile/lib/features/cardio/data/live_location_service.dart).
         No ACCESS_BACKGROUND_LOCATION is requested or needed: Build
         Session 9 Part 10's active-session background tracking uses a
         foreground service (below) instead, which only needs the
         permissions already granted here plus the two below it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Lets a live cardio session keep recording GPS fixes if the app is
         backgrounded or the phone is locked mid-session — geolocator's
         Android foreground-service technique
         (AndroidSettings.foregroundNotificationConfig), only started once
         the user has an active session and it's confirmed available (see
         GeolocatorLiveLocationService.requestBackgroundCapablePermission).
         android:foregroundServiceType="location" is declared by the
         geolocator_android plugin's own manifest, merged automatically. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Media Platform (Build Session 8 Part 3) — requested only when the
         user chooses to take a photo/video via image_picker. Also covers
         Atlas/Nova voice input (Build Session 9 Part 14): Android has no
         separate speech-recognition permission, so speech_to_text reuses
         this same RECORD_AUDIO grant — requested only when the user taps
         the mic button, never automatically. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Local, device-scheduled reminders (Build Session 9 Part 9) — no
         "always"/background permission, just Android 13+'s runtime
         notification-display permission, requested before scheduling. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Inexact scheduling only (AndroidScheduleMode.inexactAllowWhileIdle
         in LocalNotificationSchedulingService) — deliberately does not
         request SCHEDULE_EXACT_ALARM, which needs its own extra user
         consent flow for a feature where exact-to-the-minute delivery
         doesn't matter. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Remote push notifications (Build Session 11 Part 5) — tells FCM
             which notification channel to post background/terminated
             messages to, matching the "ascend_push" channel
             FirebasePushNotificationService creates for foreground
             messages. Harmless with no Firebase project configured: this
             meta-data is only read once a push actually arrives. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="ascend_push" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Research mode's "Open source" action (Build Session 12 Part
             5) — url_launcher's canLaunchUrl/launchUrl need this
             package-visibility entry on Android 11+ (API 30+), or every
             https link resolves as "nothing can handle this" even with a
             browser installed. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
