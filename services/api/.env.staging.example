# Project Ascend — STAGING environment (S15 Part 7)
#
# Copy to .env on the staging host (or feed these as real environment
# variables / container secrets — preferred, since this file's values are
# genuine secrets once filled in).
#
# The authoritative, categorized explanation of every variable here is
# packages/docs/release/staging-config-contract.md. This file is the
# fill-in-the-blanks version of that document.
#
# NEVER commit a filled-in copy of this file. NEVER reuse any secret here
# in production — see the contract doc's "Staging secrets are not
# production secrets".

# ---------------------------------------------------------------------
# REQUIRED FOR STAGING — the API hard-fails at boot without these
# ---------------------------------------------------------------------

# Node's own signal — staging deliberately runs Node in production mode.
# Never set this to "staging"; that is not a valid Node environment and
# the app will refuse to boot. See deployment-environment.ts.
NODE_ENV=production

# Ascend's deployment tier. This is what every safety check gates on.
ASCEND_ENV=staging

# Real Postgres 16+. Host must not be localhost/127.0.0.1/0.0.0.0.
DATABASE_URL=postgresql://USER:PASSWORD@staging-db.example.com:5432/ascend_staging?schema=public

# Generate each with: openssl rand -base64 48
# Must be 32+ chars, must differ from each other, must not start with
# "dev_", and must not match production's.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Explicit origin allowlist for the staging admin app. Never "*".
CORS_ORIGIN=https://staging-admin.example.com

# The real https:// URL this staging API is reachable at. Password-reset
# and email-verification links are built from it.
APP_PUBLIC_URL=https://staging-api.example.com

PORT=3000

# ---------------------------------------------------------------------
# RECOMMENDED — staging boots without these, but something degrades
# ---------------------------------------------------------------------

# Leaving EMAIL_PROVIDER=console means password-reset and
# email-verification links are only ever printed to the server log — a
# tester on a real phone cannot complete either flow. Set up real SMTP
# before testing those.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Project Ascend (Staging)

# Leaving MEDIA_STORAGE_PROVIDER=local means uploaded media does not
# survive a container restart/redeploy and is not shared across
# instances. Acceptable for a single-container staging box.
MEDIA_STORAGE_PROVIDER=local
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_PUBLIC_BASE_URL=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------------
# OPTIONAL — leave every one of these unset for Stage B
#
# Each corresponds to a feature flag that stays OFF for the connected
# Android internal beta (see packages/docs/beta/release-stages.md).
# Unset is the intended configuration, not a gap: the feature is absent
# rather than broken, and /admin/release-readiness reports each honestly.
# ---------------------------------------------------------------------

# Google sign-in (GOOGLE_SIGN_IN flag). Note the mobile app takes the
# same client id under the different name GOOGLE_CLIENT_ID, as a
# --dart-define.
GOOGLE_OAUTH_CLIENT_ID=

# Apple sign-in — iOS only, not reachable in the Android-only beta.
APPLE_CLIENT_ID=

# Live Ascend AI (LIVE_AI flag). The free, deterministic Atlas/Nova
# companion path works fully without any of these.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Research Mode retrieval (RESEARCH_MODE flag).
BRAVE_SEARCH_API_KEY=

# Remote push notifications (REMOTE_PUSH flag). Local notifications and
# in-app notification history work without these.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# Store purchases (STORE_PURCHASES flag) — off for the entire initial
# beta regardless of whether these are set.
APPLE_IAP_SHARED_SECRET=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=
