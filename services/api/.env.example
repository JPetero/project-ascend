# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Database
DATABASE_URL=postgresql://ascend:ascend_dev_password@localhost:5432/ascend_dev?schema=public

# Auth
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Media Platform (Build Session 8 Part 2) — optional. Defaults to the
# local development storage provider, which writes to services/api/storage
# and needs none of these. Set MEDIA_STORAGE_PROVIDER=s3 and the MEDIA_S3_*
# fields below to use real S3-compatible object storage.
MEDIA_STORAGE_PROVIDER=local
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_PUBLIC_BASE_URL=

# Email (password reset / email verification) — optional. Defaults to the
# console provider, which logs the email instead of sending it. Set
# EMAIL_PROVIDER=smtp and the SMTP_* fields below to send real email.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Project Ascend
APP_PUBLIC_URL=https://app.projectascend.com

# Google/Apple sign-in — optional. Leaving these unset means those
# endpoints honestly reject with "not configured" instead of pretending
# to work; no live values exist in this repo.
GOOGLE_OAUTH_CLIENT_ID=
APPLE_CLIENT_ID=

# Live AI provider (Atlas/Nova) — optional. AI_PROVIDER picks which
# adapter is active (anthropic | openai | gemini, default anthropic);
# whichever one is picked still honestly rejects with "not configured"
# if its own key below is unset, and the app falls back to its free,
# deterministic local companion. No live key exists in this repo.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-001

# Research Mode retrieval (Build Session 10 Part 16) — optional. Leaving
# this unset means Research Mode honestly rejects with "not configured"
# instead of fabricating a citation-backed answer. Get a key at
# https://brave.com/search/api/ (Web Search API).
BRAVE_SEARCH_API_KEY=

# Store purchase verification (Apple/Google) — optional. Leaving these
# unset means purchase verification honestly rejects with "not
# configured" instead of pretending a receipt/purchase token was
# checked; no live credentials exist in this repo.
APPLE_IAP_SHARED_SECRET=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=

# Remote push notifications (FCM) — optional. Leaving these unset means
# NotificationsModule falls back to NoopPushNotificationProvider, which
# honestly records "not configured" instead of pretending to deliver a
# push; no live Firebase project exists in this repo.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
