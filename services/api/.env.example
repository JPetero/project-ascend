# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Database
DATABASE_URL=postgresql://ascend:ascend_dev_password@localhost:5432/ascend_dev?schema=public

# Auth
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Email (password reset / email verification) — optional. Defaults to the
# console provider, which logs the email instead of sending it. Set
# EMAIL_PROVIDER=smtp and the SMTP_* fields below to send real email.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Project Ascend
APP_PUBLIC_URL=https://app.projectascend.com

# Google/Apple sign-in — optional. Leaving these unset means those
# endpoints honestly reject with "not configured" instead of pretending
# to work; no live values exist in this repo.
GOOGLE_OAUTH_CLIENT_ID=
APPLE_CLIENT_ID=
