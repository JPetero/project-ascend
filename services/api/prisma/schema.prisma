// Project Ascend — Prisma schema
// Portability note: `daysOfWeek` on WorkoutSchedule uses a native PostgreSQL
// text array (String[]) rather than a normalized child table. This is the
// more portable choice for a small, bounded, order-insensitive set of values
// (day names) that is always read/written as a whole with its parent record —
// it avoids a join for a field that is never queried independently, while
// remaining simple to migrate later if per-day metadata is ever needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// Minimal admin foundation — Founder Scenario 27's support/moderation
// requirements (Build Session 7 Part 10). No self-service promotion
// endpoint exists; granting ADMIN is an out-of-band operation this
// session (see build-session-7.md Part 10's known scope decisions).
enum UserRole {
  MEMBER
  ADMIN
}

// Granular admin RBAC (Build Session 9 Part 19). ADMIN alone only gates
// "is this account staff at all" — which specific admin surfaces a
// given staff account can use is governed by which of these an
// AdminPermissionGrant row exists for. MANAGE_ADMINS is itself gated
// the same way: an admin needs a MANAGE_ADMINS grant to grant or revoke
// any permission (including MANAGE_ADMINS itself) on another admin.
// Becoming ADMIN in the first place remains the out-of-band DB
// operation described above; this only splits what an existing ADMIN
// account can do once it exists.
enum AdminPermission {
  MODERATE_COMMUNITY
  REVIEW_ELIGIBILITY
  MANAGE_SUPPORT
  REVIEW_PROMOTIONS
  MANAGE_ADMINS
}

model AdminPermissionGrant {
  id         String          @id @default(uuid())
  userId     String
  permission AdminPermission
  createdAt  DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
  @@map("admin_permission_grants")
}

enum SexForCalculations {
  MALE
  FEMALE
  UNSPECIFIED
}

enum Companion {
  ATLAS
  NOVA
}

// Coaching style is independent of companion choice (Atlas/Nova) — see
// packages/docs/product/atlas-nova-bible.md. TOUGH must never insult, shame,
// or override safety rules; it's intensity of delivery, not permission to
// be unsafe.
enum CoachingStyle {
  GENTLE
  BALANCED
  DIRECT
  TOUGH
  ATHLETE
}

enum CompanionMode {
  STANDARD
  CHIBI
}

enum ThemeMode {
  SYSTEM
  LIGHT
  DARK
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum LegalDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
}

enum DeviceConnectionStatus {
  CONNECTED
  DISCONNECTED
  PENDING
  ERROR
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  // Null until the user completes an email-verification link. Never
  // inferred or auto-set — only EmailVerificationToken confirmation sets
  // this (see AuthService.verifyEmail).
  emailVerifiedAt DateTime?
  status          UserStatus @default(ACTIVE)
  role            UserRole   @default(MEMBER)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  refreshTokens                    RefreshToken[]
  passwordResetTokens              PasswordResetToken[]
  emailVerificationTokens          EmailVerificationToken[]
  profile                          Profile?
  preference                       Preference?
  equipment                        Equipment[]
  workoutSchedule                  WorkoutSchedule?
  devices                          DeviceConnection[]
  auditEvents                      AuditEvent[]
  workoutPlans                     WorkoutPlan[]
  workoutSessions                  WorkoutSession[]
  personalRecords                  PersonalRecord[]
  syncOperations                   SyncOperation[]
  ownedFoods                       Food[]
  mealEntries                      MealEntry[]
  macroTarget                      MacroTarget?
  waterEntries                     WaterEntry[]
  authIdentities                   AuthIdentity[]
  legalAcceptances                 LegalAcceptance[]
  deloadRecommendations            DeloadRecommendation[]
  savedMeals                       SavedMeal[]
  achievementAwards                AchievementAward[]
  cardioSessions                   CardioSession[]
  healthMetricSamples              HealthMetricSample[]
  healthSyncCursors                HealthSyncCursor[]
  communityProfile                 CommunityProfile?
  communityPosts                   CommunityPost[]
  communityLikes                   CommunityLike[]
  communityComments                CommunityComment[]
  communitySaves                   CommunitySave[]
  communityReports                 CommunityReport[]
  communityFollowing               CommunityFollow[]               @relation("CommunityFollower")
  communityFollowers               CommunityFollow[]               @relation("CommunityFollowing")
  communityBlocksMade              CommunityBlock[]                @relation("CommunityBlocker")
  communityBlocksAgainst           CommunityBlock[]                @relation("CommunityBlocked")
  ownedTrainerGroups               TrainerGroup[]
  trainerGroupMembers              TrainerGroupMember[]
  trainerGroupMessages             TrainerGroupMessage[]
  trainerGroupInvitesSent          TrainerGroupInvitation[]        @relation("TrainerGroupInviter")
  trainerGroupInvitesReceived      TrainerGroupInvitation[]        @relation("TrainerGroupInvitee")
  trainerGroupSharedPlans          TrainerGroupSharedPlan[]
  trainerGroupAnnouncements        TrainerGroupAnnouncement[]
  rankingOptIn                     RankingOptIn?
  createdChallenges                Challenge[]
  challengeParticipations          ChallengeParticipant[]
  subscription                     UserSubscription?
  affordabilityEligibility         AffordabilityEligibility?
  supportTickets                   SupportTicket[]
  supportTicketReplies             SupportTicketReply[]
  promotedCampaigns                PromotedCampaign[]
  mediaAssets                      MediaAsset[]
  friendRequestsSent               FriendRequest[]                 @relation("FriendRequestSender")
  friendRequestsReceived           FriendRequest[]                 @relation("FriendRequestRecipient")
  friendshipsAsUserA               Friendship[]                    @relation("FriendshipUserA")
  friendshipsAsUserB               Friendship[]                    @relation("FriendshipUserB")
  directConversationsStarted       DirectConversation[]            @relation("DirectConversationInitiator")
  directConversationParticipations DirectConversationParticipant[]
  directMessagesSent               DirectMessage[]
  messageReceipts                  MessageReceipt[]
  messageReports                   MessageReport[]
  hostedJointWorkoutSessions       JointWorkoutSession[]
  jointWorkoutParticipations       JointWorkoutParticipant[]
  jointWorkoutEvents               JointWorkoutEvent[]
  createdSportMatches              SportMatch[]
  sportMatchParticipations         SportMatchParticipant[]
  sportScoreProposals              SportScoreProposal[]
  sportScoreConfirmations          SportScoreConfirmation[]
  sportMatchDisputes               SportMatchDispute[]
  sportRatings                     SportRating[]
  savedNutrientArticles            SavedNutrientArticle[]
  notificationPreference           NotificationPreference?
  notificationEvents               NotificationEvent[]
  galleryAlbums                    GalleryAlbum[]
  purchases                        Purchase[]
  adminPermissionGrants            AdminPermissionGrant[]
  visionAnalysisSessions           VisionAnalysisSession[]
  pushDeviceTokens                 PushDeviceToken[]
  companionMemory                  CompanionMemory?

  @@index([status])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  // Shared by every token descended from the same login/register — i.e. the
  // original token and every token it was rotated into. Lets us revoke an
  // entire session lineage at once when reuse of an already-rotated token
  // indicates possible theft (see AuthService.handleRefreshTokenReuse).
  familyId   String
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  // Set only when this specific token was revoked as part of family-wide
  // reuse handling (AuthService.handleRefreshTokenReuse), never on an
  // ordinary rotation revoke — lets an auditor distinguish "rotated
  // normally" from "killed because a stolen/replayed token surfaced" just
  // by reading the row, without needing the AuditEvent log.
  reusedAt   DateTime?
  deviceName String?
  // Freeform client-reported platform label ("ios" | "android" | "web"),
  // purely informational for the "Your devices" list — never used for any
  // security decision.
  platform   String?
  // Copied forward unchanged on every rotation (Build Session 10 Part 11),
  // unlike `createdAt` which resets to "now" on each rotated row. This is
  // what lets the sessions list show "signed in 3 days ago" for a device
  // that has silently refreshed many times since.
  sessionCreatedAt DateTime @default(now())
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Build Session 9 Part 4 — single-use, short-lived password-reset
/// capability tokens. Follows RefreshToken's hashing convention exactly:
/// only an argon2 hash of the random secret is ever stored, the raw
/// secret exists only in the emailed link. `usedAt` guards against
/// replay the same way RefreshToken.revokedAt does; requesting a new
/// reset token invalidates any prior outstanding one for that user.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Build Session 9 Part 4 — single-use email-ownership confirmation
/// tokens, same shape and hashing convention as PasswordResetToken.
/// Confirming one sets User.emailVerifiedAt.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Profile {
  id                  String             @id @default(uuid())
  userId              String             @unique
  firstName           String
  dateOfBirth         DateTime?
  countryCode         String?
  languageCode        String             @default("en")
  timezone            String             @default("UTC")
  unitSystem          UnitSystem         @default(METRIC)
  sexForCalculations  SexForCalculations @default(UNSPECIFIED)
  heightCm            Float?
  weightKg            Float?
  primaryGoal         String?
  experienceLevel     String?
  onboardingCompleted Boolean            @default(false)
  onboardingStep      Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Preference {
  id                   String        @id @default(uuid())
  userId               String        @unique
  companion            Companion     @default(ATLAS)
  companionMode        CompanionMode @default(STANDARD)
  // Independent of `companion` by design — see
  // packages/docs/product/atlas-nova-bible.md. Neither Atlas nor Nova is
  // "for" a given coaching style.
  coachingStyle        CoachingStyle @default(BALANCED)
  // 1 (softest) - 5 (most intense) delivery of the selected coachingStyle.
  // Never changes what's safe to recommend, only how it's phrased.
  toneIntensity        Int           @default(3)
  themeMode            ThemeMode     @default(SYSTEM)
  reducedMotion        Boolean       @default(false)
  notificationsEnabled Boolean       @default(true)
  aiMemoryEnabled      Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("preferences")
}

model Equipment {
  id         String  @id @default(uuid())
  userId     String
  type       String
  customName String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("equipment")
}

model WorkoutSchedule {
  id              String   @id @default(uuid())
  userId          String   @unique
  durationMinutes Int
  preferredTime   String?
  daysOfWeek      String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workout_schedules")
}

model DeviceConnection {
  id                String                 @id @default(uuid())
  userId            String
  provider          String
  // Distinguishes multiple physical devices from the same provider (e.g.
  // two paired Garmin watches). Defaults to the literal "default" when the
  // client doesn't supply one, which preserves the original one-connection-
  // per-provider behavior for providers/clients that don't yet track a
  // real per-device identifier — see packages/docs/build-session-1.md for
  // the reasoning.
  connectionKey     String                 @default("default")
  displayName       String
  status            DeviceConnectionStatus @default(PENDING)
  externalAccountId String?
  lastSyncedAt      DateTime?
  metadata          Json                   @default("{}")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, connectionKey])
  @@index([userId])
  @@index([provider])
  @@map("device_connections")
}

// Normalized health-data types every adapter (Health Connect, HealthKit,
// a future vendor adapter) maps its provider-specific data into — see
// packages/docs/wearables.md's "Planned architecture for real
// integrations" section, now implemented for Health Connect/HealthKit.
enum HealthMetric {
  STEPS
  HEART_RATE
  RESTING_HEART_RATE
  EXERCISE_SESSION
  ACTIVE_CALORIES
  DISTANCE
  SLEEP
  CYCLING_DISTANCE
}

// One normalized sample from a connected health platform. `recordedAt` is
// always stored in UTC; `recordedTimezone` preserves the originating IANA
// timezone alongside it (e.g. "steps on Tuesday" depends on where the user
// was) per wearables.md's timezone-handling requirement.
model HealthMetricSample {
  id               String       @id @default(uuid())
  userId           String
  metric           HealthMetric
  value            Float
  // Always the normalized unit for this metric (steps: count, heart
  // rate: bpm, distance/cyclingDistance: meters, activeCalories: kcal,
  // sleep: minutes) — never the platform's raw unit, which is converted
  // at ingestion so nothing downstream needs to know which provider a
  // sample came from.
  unit             String
  recordedAt       DateTime
  recordedTimezone String?
  // 'HEALTH_CONNECT' | 'APPLE_HEALTH' | a vendor string surfaced through
  // one of those hubs (e.g. 'XIAOMI') — mirrors DeviceConnection.provider.
  sourceProvider   String
  sourceDeviceId   String?
  // The platform's own record identifier, when it exposes one — kept
  // for debugging/support, not used as the dedup key (see the unique
  // constraint below, which is what actually prevents double-counting
  // the same sample reported by two providers or re-synced twice).
  externalId       String?
  createdAt        DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, metric, sourceProvider, recordedAt])
  @@index([userId, metric, recordedAt])
  @@map("health_metric_samples")
}

// An opaque, per-(user, provider, metric) incremental-sync bookmark — see
// wearables.md's SyncCursor design. Lets a sync call ask "anything new
// since last time" instead of re-fetching a provider's entire history.
model HealthSyncCursor {
  id           String       @id @default(uuid())
  userId       String
  provider     String
  metric       HealthMetric
  cursor       String
  lastSyncedAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, metric])
  @@map("health_sync_cursors")
}

model AuditEvent {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Workout Engine (Sprint 2)
// ---------------------------------------------------------------------------
// Two-tier workout model, the same shape as most content-catalog systems:
//   - Workout / WorkoutExercise: a shared, curated catalog (seeded, not
//     user-owned) that the "Browse workouts" surface reads.
//   - WorkoutPlan / WorkoutPlanExercise: a user's own plan. Starting a plan
//     "from" a catalog Workout copies its exercises in rather than
//     referencing them live, so a user customizing their plan (reordering,
//     changing target sets/reps) never mutates the shared catalog.
//
// There is deliberately no `WorkoutHistory` table. "History" is a read
// model — a query over completed `WorkoutSession`/`WorkoutSet` rows, served
// by the history module's service — not a separate table that would just be
// another copy of the same facts to keep in sync for no query benefit.
//
// Weight/duration/distance are always stored in canonical metric units
// (kg / seconds / meters), the same convention `Profile.heightCm` and
// `Profile.weightKg` already use — the client converts for display based on
// `Preference.unitSystem` (not modeled here; conversion is presentation-only).

enum ExerciseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MuscleRole {
  PRIMARY
  SECONDARY
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
  ABANDONED
}

enum PersonalRecordType {
  MAX_WEIGHT
  MAX_REPS
  MAX_DURATION
  MAX_DISTANCE
  MAX_VOLUME
  // Epley-formula estimate from a single completed set (see
  // ProgressionService docs) — always presented to the user as an
  // estimate, never a measured max.
  ESTIMATED_ONE_REP_MAX
  // Fastest meters-per-second across a session's distance+duration sets;
  // only ever computed when both values are present and valid.
  BEST_PACE
}

// Controls which of WorkoutSet's optional fields are meaningful for a given
// exercise, and which input controls the Workout Player shows. Deliberately
// excludes a CALORIES option — see build-session-1.md's P1.1 entry for why
// (no real estimation pipeline exists yet, and a fabricated calorie number
// would violate the "no fake health data" rule).
enum MeasurementType {
  REPS_WEIGHT
  REPS_ONLY
  DURATION
  DISTANCE_DURATION
  ASSISTED_WEIGHT
  BODYWEIGHT
}

model ExerciseCategory {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  exercises Exercise[]
  workouts  Workout[]

  @@map("exercise_categories")
}

model MuscleGroup {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  exerciseMuscles ExerciseMuscle[]

  @@map("muscle_groups")
}

model EquipmentType {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  exerciseEquipment ExerciseEquipment[]

  @@map("equipment_types")
}

model Exercise {
  id              String             @id @default(uuid())
  name            String
  slug            String             @unique
  description     String
  difficulty      ExerciseDifficulty @default(BEGINNER)
  measurementType MeasurementType    @default(REPS_WEIGHT)
  instructions    String
  safetyTips      String
  commonMistakes  String
  // Placeholders only in this sprint — no media pipeline yet (see
  // packages/docs/roadmap.md). Nullable so seed data can omit them without
  // every exercise needing a fake URL.
  imageUrl        String?
  videoUrl        String?
  categoryId      String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  category  ExerciseCategory    @relation(fields: [categoryId], references: [id])
  muscles   ExerciseMuscle[]
  equipment ExerciseEquipment[]

  alternativesFrom ExerciseAlternative[] @relation("ExerciseAlternativesFrom")
  alternativesTo   ExerciseAlternative[] @relation("ExerciseAlternativesTo")

  workoutExercises     WorkoutExercise[]
  workoutPlanExercises WorkoutPlanExercise[]
  workoutSets          WorkoutSet[]
  personalRecords      PersonalRecord[]

  substitutionsAsOriginal   WorkoutSessionSubstitution[] @relation("SubstitutionOriginal")
  substitutionsAsSubstitute WorkoutSessionSubstitution[] @relation("SubstitutionReplacement")

  @@index([categoryId])
  @@map("exercises")
}

model ExerciseMuscle {
  id            String     @id @default(uuid())
  exerciseId    String
  muscleGroupId String
  role          MuscleRole

  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroup MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, muscleGroupId])
  @@index([muscleGroupId])
  @@map("exercise_muscles")
}

model ExerciseEquipment {
  id              String @id @default(uuid())
  exerciseId      String
  equipmentTypeId String

  exercise      Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, equipmentTypeId])
  @@index([equipmentTypeId])
  @@map("exercise_equipment")
}

// Seed data inserts both directions explicitly (A->B and B->A) rather than
// making every read infer the reverse relationship — simpler queries, at
// the cost of seed data needing to keep both directions consistent.
model ExerciseAlternative {
  id                    String @id @default(uuid())
  exerciseId            String
  alternativeExerciseId String

  exercise            Exercise @relation("ExerciseAlternativesFrom", fields: [exerciseId], references: [id], onDelete: Cascade)
  alternativeExercise Exercise @relation("ExerciseAlternativesTo", fields: [alternativeExerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, alternativeExerciseId])
  @@index([alternativeExerciseId])
  @@map("exercise_alternatives")
}

model Workout {
  id                       String             @id @default(uuid())
  name                     String
  slug                     String             @unique
  description              String
  categoryId               String
  difficulty               ExerciseDifficulty @default(BEGINNER)
  estimatedDurationMinutes Int
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  category  ExerciseCategory  @relation(fields: [categoryId], references: [id])
  exercises WorkoutExercise[]
  plans     WorkoutPlan[]

  @@index([categoryId])
  @@map("workouts")
}

model WorkoutExercise {
  id                    String  @id @default(uuid())
  workoutId             String
  exerciseId            String
  order                 Int
  targetSets            Int
  targetReps            Int?
  targetDurationSeconds Int?
  targetWeightKg        Float?
  targetDistanceMeters  Float?
  restSeconds           Int     @default(60)
  notes                 String?

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([workoutId, order])
  @@index([exerciseId])
  @@map("workout_exercises")
}

model WorkoutPlan {
  id          String    @id @default(uuid())
  userId      String
  // The catalog Workout this plan started from, if any — kept only as a
  // "based on" reference; WorkoutPlanExercise rows are this plan's own
  // copy, so the plan is unaffected if the catalog Workout later changes.
  workoutId   String?
  name        String
  description String?
  // Soft-delete: archived plans are hidden from the default plan list but
  // never physically removed, so past sessions started from them keep a
  // resolvable `workoutPlan` relation. `DELETE /workout-plans/:id` still
  // exists for a true hard delete when nothing references the plan.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout        Workout?                 @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  exercises      WorkoutPlanExercise[]
  sessions       WorkoutSession[]
  sharedInGroups TrainerGroupSharedPlan[]

  @@index([userId])
  @@map("workout_plans")
}

model WorkoutPlanExercise {
  id                    String  @id @default(uuid())
  workoutPlanId         String
  exerciseId            String
  order                 Int
  targetSets            Int
  targetReps            Int?
  targetDurationSeconds Int?
  targetWeightKg        Float?
  targetDistanceMeters  Float?
  restSeconds           Int     @default(60)
  notes                 String?

  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercise    Exercise    @relation(fields: [exerciseId], references: [id])

  @@unique([workoutPlanId, order])
  @@index([exerciseId])
  @@map("workout_plan_exercises")
}

model WorkoutSession {
  id                    String               @id @default(uuid())
  userId                String
  workoutPlanId         String?
  status                WorkoutSessionStatus @default(IN_PROGRESS)
  startedAt             DateTime             @default(now())
  // Start of the *current* active streak — set on start() and every
  // resume(). pause()/finish() add (now - resumedAt) to
  // activeDurationSeconds before clearing/ignoring it, which is what makes
  // multiple pause/resume cycles accumulate correctly instead of just the
  // last streak.
  resumedAt             DateTime             @default(now())
  pausedAt              DateTime?
  completedAt           DateTime?
  // Accumulated active seconds, excluding paused time — updated on
  // pause/resume/finish rather than derived from completedAt - startedAt,
  // since that delta would incorrectly include any paused time.
  activeDurationSeconds Int                  @default(0)
  notes                 String?
  // Optional whole-session difficulty rating, same 1-10 scale as per-set
  // RPE, entered once at finish() rather than per set.
  difficultyRating      Int?
  createdAt             DateTime             @default(now())

  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutPlan     WorkoutPlan?                 @relation(fields: [workoutPlanId], references: [id], onDelete: SetNull)
  sets            WorkoutSet[]
  personalRecords PersonalRecord[]
  substitutions   WorkoutSessionSubstitution[]

  @@index([userId])
  @@index([userId, status])
  @@index([workoutPlanId])
  @@map("workout_sessions")
}

// Records that, within one session, sets logged against `originalExerciseId`
// should from now on be logged against `substituteExerciseId` instead.
// Deliberately does NOT touch already-created `WorkoutSet` rows — those
// keep referencing whichever exercise they were actually logged against,
// so completed history is never rewritten. One active substitution per
// (session, original exercise): substituting again just replaces it.
model WorkoutSessionSubstitution {
  id                   String   @id @default(uuid())
  workoutSessionId     String
  originalExerciseId   String
  substituteExerciseId String
  createdAt            DateTime @default(now())

  workoutSession     WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  originalExercise   Exercise       @relation("SubstitutionOriginal", fields: [originalExerciseId], references: [id])
  substituteExercise Exercise       @relation("SubstitutionReplacement", fields: [substituteExerciseId], references: [id])

  @@unique([workoutSessionId, originalExerciseId])
  @@index([workoutSessionId])
  @@map("workout_session_substitutions")
}

model WorkoutSet {
  id               String   @id @default(uuid())
  workoutSessionId String
  exerciseId       String
  setNumber        Int
  reps             Int?
  weightKg         Float?
  durationSeconds  Int?
  distanceMeters   Float?
  // Rate of Perceived Exertion, 1-10, half-point increments allowed (e.g.
  // 7.5) — the standard resolution most RPE scales use. Optional and
  // purely subjective; never treated as a medical measurement. See
  // ProgressionService for how it tempers (but never blocks) a load
  // increase.
  rpe              Float?
  isWarmup         Boolean  @default(false)
  completedAt      DateTime @default(now())

  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise       Exercise       @relation(fields: [exerciseId], references: [id])

  @@unique([workoutSessionId, exerciseId, setNumber])
  @@index([exerciseId])
  @@map("workout_sets")
}

model PersonalRecord {
  id               String             @id @default(uuid())
  userId           String
  exerciseId       String
  type             PersonalRecordType
  value            Float
  unit             String
  workoutSessionId String?
  achievedAt       DateTime           @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise       Exercise        @relation(fields: [exerciseId], references: [id])
  workoutSession WorkoutSession? @relation(fields: [workoutSessionId], references: [id], onDelete: SetNull)

  // One current-best row per (user, exercise, category) — broken records
  // are updated in place, not appended. The session/date it was set on is
  // still recoverable from `workoutSessionId` / `achievedAt`; a full
  // append-only PR log isn't needed for "what's my current best" or
  // "celebrate a new one", which is all this sprint's Personal Records page
  // does.
  @@unique([userId, exerciseId, type])
  @@index([userId])
  @@map("personal_records")
}

// ---------------------------------------------------------------------------
// Shared synchronization / idempotency system (Build Session 2)
// ---------------------------------------------------------------------------
// One reusable idempotency ledger for every offline-capable mutation across
// features (workout sets, plans, substitutions today; nutrition entries as
// of this same session) rather than a bespoke table per feature. A client
// generates `idempotencyKey` once per logical mutation (typically a UUID
// stored alongside the local record) and resends the same key on every
// retry; `IdempotencyService` (services/api/src/common/idempotency) turns
// that into "run exactly once, replay the same result on any retry" for
// whichever endpoints opt in. See packages/docs/build-session-2.md for the
// conflict policy this implements.
enum SyncOperationStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model SyncOperation {
  id              String              @id @default(uuid())
  userId          String
  idempotencyKey  String
  entityType      String
  operationType   String
  localEntityId   String?
  clientCreatedAt DateTime?
  payloadVersion  Int                 @default(1)
  status          SyncOperationStatus @default(PROCESSING)
  resultEntityId  String?
  // The exact response body returned the first time this key was
  // processed, so a retry replays byte-for-byte instead of recomputing
  // (and potentially disagreeing with) the original result.
  resultPayload   Json?
  errorMessage    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Enforces "at most one outcome per user per idempotency key" at the
  // database level — the real backstop against duplicate processing, not
  // just application-level checking.
  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@map("sync_operations")
}

// ---------------------------------------------------------------------------
// Nutrition Tracking foundation (Build Session 2)
// ---------------------------------------------------------------------------
// Deliberately no camera/scanner capture yet (see packages/docs/roadmap.md).
// All macro values are stored per `Food`'s own reference serving
// (`servingDescription`/`servingGrams`); `FoodServing` rows are just named,
// user-facing serving options (e.g. "1 cup cooked", "100 g") that resolve to
// a gram quantity for scaling, not a second copy of the macro data.
// `MealEntry` snapshots the computed macros at log time rather than
// re-deriving them from `Food` on every read, specifically so editing or
// archiving a `Food` later never silently rewrites a user's already-logged
// history — the same principle already used for `WorkoutSet`/`PersonalRecord`
// in the Workout Engine.
enum FoodSourceType {
  SEED
  USER
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model Food {
  id                     String         @id @default(uuid())
  // Stable natural key for seeded foods only, so the idempotent seed
  // script can upsert by slug the same way the exercise/workout seed
  // does. Always null for user-created foods — NULLs don't collide under
  // a Postgres unique index, so many custom foods can coexist with none.
  slug                   String?        @unique
  name                   String
  // e.g. a local-language name alongside `name` — informational only.
  alternateName          String?
  brand                  String?
  sourceType             FoodSourceType @default(SEED)
  // Set only for sourceType = USER; a seeded food has no owner and can
  // never be edited or archived by any single user.
  ownerId                String?
  servingDescription     String
  servingGrams           Float?
  caloriesPerServing     Float
  proteinGramsPerServing Float
  carbGramsPerServing    Float
  fatGramsPerServing     Float
  fiberGramsPerServing   Float?
  sodiumMgPerServing     Float?
  // True for essentially all of this session's seed data and every
  // user-entered custom food — this app has no lab-verified nutrition
  // database, so values are always approximate unless a future, real
  // verified source is integrated.
  isEstimated            Boolean        @default(true)
  archivedAt             DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  owner          User?           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  servings       FoodServing[]
  mealEntries    MealEntry[]
  savedMealItems SavedMealItem[]

  @@index([ownerId])
  @@index([name])
  @@map("foods")
}

model FoodServing {
  id        String  @id @default(uuid())
  foodId    String
  label     String
  // Null for a serving unit that isn't gram-convertible (e.g. "1 piece" for
  // a food only ever logged by count) — `MealEntry.loggedByGrams` covers
  // the gram-entry path independently of which serving option was picked.
  grams     Float?
  isDefault Boolean @default(false)

  food           Food            @relation(fields: [foodId], references: [id], onDelete: Cascade)
  mealEntries    MealEntry[]
  savedMealItems SavedMealItem[]

  @@index([foodId])
  @@map("food_servings")
}

model MealEntry {
  id            String   @id @default(uuid())
  userId        String
  foodId        String
  foodServingId String?
  mealType      MealType
  date          DateTime @db.Date
  quantity      Float
  loggedByGrams Boolean  @default(false)
  gramsLogged   Float?
  // Snapshot at log time — see the section comment above.
  calories      Float
  proteinGrams  Float
  carbGrams     Float
  fatGrams      Float
  fiberGrams    Float?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  food        Food         @relation(fields: [foodId], references: [id])
  foodServing FoodServing? @relation(fields: [foodServingId], references: [id])

  @@index([userId, date])
  @@map("meal_entries")
}

model MacroTarget {
  id                 String   @id @default(uuid())
  userId             String   @unique
  calorieTarget      Int
  proteinGramsTarget Int
  carbGramsTarget    Int
  fatGramsTarget     Int
  fiberGramsTarget   Int?
  // True when this row was populated by the safe-default estimator rather
  // than typed in by the user — the Flutter UI uses this to keep showing
  // "estimated" framing until the user edits and implicitly confirms it.
  isEstimatedDefault Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("macro_targets")
}

model WaterEntry {
  id       String   @id @default(uuid())
  userId   String
  date     DateTime @db.Date
  amountMl Int
  loggedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("water_entries")
}

// --- Scenario 1/2/3: sign-in identities and legal acceptance -------------
// See packages/docs/product/user-scenario-bible.md.

// One row per external identity linked to an Ascend account. Every existing
// user is backfilled with an EMAIL row (providerSubject = their user id) so
// email/password login keeps working through the same lookup path once
// Google/Apple linking (Scenario 2/3) goes live. Live Google/Apple OAuth
// itself is NOT implemented this session — no credentials configured — this
// is the durable architecture only.
model AuthIdentity {
  id              String       @id @default(uuid())
  userId          String
  provider        AuthProvider
  // The provider's stable subject identifier for this identity (Google/Apple
  // `sub`, or the user's own id for the EMAIL backfill row). Never the raw
  // provider access token.
  providerSubject String
  providerEmail   String?
  createdAt       DateTime     @default(now())
  lastUsedAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Prevents one external identity (e.g. one Google account) from ever being
  // linked to two different Ascend users.
  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

// A specific published version of a legal document. Content is a
// product-safe draft requiring professional legal review before
// jurisdiction-specific release — see
// packages/docs/product/wellness-ethics-bible.md.
model LegalDocument {
  id          String            @id @default(uuid())
  type        LegalDocumentType
  version     String
  publishedAt DateTime          @default(now())
  content     String

  acceptances LegalAcceptance[]

  @@unique([type, version])
  @@map("legal_documents")
}

model LegalAcceptance {
  id              String   @id @default(uuid())
  userId          String
  legalDocumentId String
  acceptedAt      DateTime @default(now())
  regionCode      String?

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalDocument LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([legalDocumentId])
  @@map("legal_acceptances")
}

// --- Scenario 10: deload recommendation -----------------------------------

// A single deload suggestion surfaced to the user. Never auto-applied —
// always optional, dismissible, and postponable. See
// packages/docs/product/user-scenario-bible.md Scenario 10 for the
// deterministic signals allowed to produce one (no fabricated
// sleep/recovery data).
model DeloadRecommendation {
  id             String    @id @default(uuid())
  userId         String
  suggestedAt    DateTime  @default(now())
  reason         String
  dismissedAt    DateTime?
  postponedUntil DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("deload_recommendations")
}

// --- Saved meals — see packages/docs/product/user-scenario-bible.md
// Part 7 / Founder marathon "Finish Nutrition". A named, reusable group of
// food entries a user can log in one action instead of re-searching each
// item every time. ---

model SavedMeal {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SavedMealItem[]

  @@index([userId])
  @@map("saved_meals")
}

model SavedMealItem {
  id            String  @id @default(uuid())
  savedMealId   String
  foodId        String
  foodServingId String?
  quantity      Float

  savedMeal   SavedMeal    @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
  food        Food         @relation(fields: [foodId], references: [id])
  foodServing FoodServing? @relation(fields: [foodServingId], references: [id])

  @@index([savedMealId])
  @@map("saved_meal_items")
}

// --- Achievements — Founder Scenario 11. Ascend owns the canonical
// cross-platform record; award logic is idempotent via the unique
// (userId, achievementId) pair below (an upsert, never a duplicate
// insert). See packages/docs/product/wellness-ethics-bible.md's
// "Achievement safety" section for the conditions this must never
// reward. ---

enum AchievementCategory {
  WORKOUT
  NUTRITION
  CONSISTENCY
  CARDIO
  RECOVERY
}

model Achievement {
  id          String              @id @default(uuid())
  // Stable key the award-evaluation code matches against (e.g.
  // "first_workout") — never renamed once shipped, since it's the
  // durable identity an external sync (Play Games / Game Center,
  // future) would eventually map to as well.
  key         String              @unique
  title       String
  description String
  iconAsset   String
  category    AchievementCategory
  // Steps needed to "complete" a multi-step achievement (e.g. 10 active
  // days = 10). 1 for a simple one-shot achievement.
  targetSteps Int                 @default(1)
  createdAt   DateTime            @default(now())

  awards AchievementAward[]

  @@map("achievements")
}

model AchievementAward {
  id            String    @id @default(uuid())
  userId        String
  achievementId String
  progress      Int       @default(0)
  // Null until targetSteps is reached — a row can exist purely to track
  // in-progress steps toward a multi-step achievement without having
  // "earned" it yet.
  earnedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  // The idempotency guarantee: evaluating the same trigger twice for a
  // user upserts this one row rather than creating a duplicate award.
  @@unique([userId, achievementId])
  @@index([userId])
  @@map("achievement_awards")
}

// --- GPS cardio — Founder Scenario 12. This session implements manual/
// summary cardio logging (duration, distance, activity type) with the
// privacy fields a future live-GPS route recorder will need; it does not
// implement live on-device GPS tracking — that requires platform location
// permission plumbing (geolocator/permission_handler) that can't be
// exercised or verified in this sandboxed build environment. See
// packages/docs/product/parking-lot.md. ---

enum CardioActivityType {
  WALK
  JOG
  RUN
  SPRINT
  CYCLE
  HIKE
  WHEELCHAIR
  OTHER
}

// Distinguishes how a session's summary numbers were produced — matters
// for privacy (only LIVE_GPS ever has route points to store) and, later,
// for Rankings anti-cheat (a manual entry must never be silently treated
// as GPS-verified). See packages/docs/product/user-scenario-bible.md
// Scenario 12/25's manual-vs-verified distinction.
enum CardioSessionSource {
  MANUAL
  LIVE_GPS
  WEARABLE
}

model CardioSession {
  id                  String              @id @default(uuid())
  userId              String
  activityType        CardioActivityType
  source              CardioSessionSource @default(MANUAL)
  startedAt           DateTime
  durationSeconds     Int
  distanceMeters      Float?
  elevationGainMeters Float?
  // A clear-estimate-labeled figure, never presented as precise — see
  // wellness-ethics-bible.md's "explain uncertainty" principle.
  estimatedCalories   Float?
  // Coarse, user-entered region tag (e.g. "Quezon City") — never exact
  // coordinates. Manual tags must never imply a measured/fabricated
  // distance; distanceMeters stays null unless the user actually entered
  // one.
  regionLabel         String?
  // Private-by-default route/location visibility, independent toggles
  // per Scenario 12's "hide start / end / route" requirement.
  hideRoute           Boolean             @default(true)
  hideStartLocation   Boolean             @default(true)
  hideEndLocation     Boolean             @default(true)
  // Google-style encoded polyline (see common/geo/polyline.util.ts) of a
  // LIVE_GPS session's route, already endpoint-trimmed per
  // hideStartLocation/hideEndLocation and entirely absent when
  // hideRoute is true — trimmed/discarded points are never persisted in
  // the first place, not merely filtered at read time. Null for MANUAL
  // sessions (no coordinates were ever recorded) and for any session
  // whose owner chose hideRoute.
  encodedRoute        String?             @db.Text
  // Point count of the route actually stored (post-trimming), kept
  // alongside encodedRoute for display/debugging without decoding it.
  routePointCount     Int?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("cardio_sessions")
}

// --- Community — Founder Scenario 21's profiles/posts/Reels MVP. See
// packages/docs/product/user-scenario-bible.md's Community Reels
// requirements: captions, likes, comments, saves, follows, reports,
// blocks, per-post visibility, creator/trainer profiles. No automatic
// publishing to Instagram/Facebook/TikTok is implemented or claimed —
// "native sharing" is device-share-sheet only (see the Flutter side).
// Moderation here is a status field an admin tool can act on later, not
// an automated content-classification pipeline.

enum CommunityPostMediaType {
  TEXT
  IMAGE
  VIDEO
}

// VIDEO + a caption is what the product spec calls a "Reel" — modeled as
// a media type rather than a separate table, since a Reel is a post in
// every other respect (likes/comments/saves/visibility/moderation).
enum CommunityVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

// A whole profile's own visibility — distinct from CommunityVisibility
// above, which is per-post. FRIENDS uses the real mutual Friendship
// graph (Build Session 8 Part 7), not CommunityFollow, matching
// user-scenario-bible.md's "friends" privacy option.
enum CommunityProfileVisibility {
  PRIVATE
  FRIENDS
  FOLLOWERS
  PUBLIC
}

enum CommunityModerationStatus {
  APPROVED
  PENDING
  REMOVED
}

enum CommunityReportTargetType {
  POST
  COMMENT
  PROFILE
  // Reports against a MediaAsset directly (Build Session 8 Part 2's
  // Media Platform) — e.g. a profile photo or chat image that never
  // became a Community post. targetId is a MediaAsset.id.
  MEDIA_ASSET
}

enum CommunityReportStatus {
  OPEN
  REVIEWED
  ACTIONED
}

// The public-facing identity shown on posts/comments/follow lists —
// deliberately separate from `Profile`, which holds private onboarding
// data (date of birth, height/weight, goals) that must never be exposed
// through a Community endpoint.
model CommunityProfile {
  id                 String                     @id @default(uuid())
  userId             String                     @unique
  displayName        String
  bio                String?
  // Kept for backward compatibility with profiles created before the
  // Media Platform existed — new avatars/covers use avatarMediaAssetId/
  // coverMediaAssetId below instead (Build Session 9 Part 2). Never
  // written to for a new upload; still read as a fallback display value.
  avatarUrl          String?
  // A trainer/creator's own posts can be flagged as trainer content per
  // post (CommunityPost.isTrainerContent); this flag controls whether a
  // "Trainer" badge shows next to their name/profile at all.
  isTrainer          Boolean                    @default(false)
  // Free from day one — per parking-lot.md's "Profile customization and
  // safe media (14)" note, privacy controls ship free, not as a later
  // premium layer. PUBLIC matches the pre-existing default visibility a
  // profile had before this field existed (Build Session 9 Part 2).
  visibility         CommunityProfileVisibility @default(PUBLIC)
  avatarMediaAssetId String?
  coverMediaAssetId  String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarMediaAsset MediaAsset? @relation("CommunityProfileAvatar", fields: [avatarMediaAssetId], references: [id], onDelete: SetNull)
  coverMediaAsset  MediaAsset? @relation("CommunityProfileCover", fields: [coverMediaAssetId], references: [id], onDelete: SetNull)

  @@map("community_profiles")
}

model CommunityPost {
  id               String                    @id @default(uuid())
  authorId         String
  mediaType        CommunityPostMediaType    @default(TEXT)
  // A device-local file reference or externally-hosted URL — this
  // session has no media upload/transcoding pipeline, so the app is
  // responsible for producing a URL before creating the post (see
  // packages/docs/build-session-7.md Part 4's platform-limitations
  // section). Required whenever mediaType isn't TEXT — enforced in the
  // DTO/service, not the database.
  mediaUrl         String?
  caption          String?                   @db.Text
  visibility       CommunityVisibility       @default(PUBLIC)
  moderationStatus CommunityModerationStatus @default(APPROVED)
  isTrainerContent Boolean                   @default(false)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  author            User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes             CommunityLike[]
  comments          CommunityComment[]
  saves             CommunitySave[]
  promotedCampaigns PromotedCampaign[]

  @@index([authorId, createdAt])
  @@index([visibility, moderationStatus, createdAt])
  @@map("community_posts")
}

model CommunityLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("community_likes")
}

model CommunityComment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("community_comments")
}

model CommunitySave {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("community_saves")
}

model CommunityFollow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("CommunityFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("CommunityFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("community_follows")
}

model CommunityBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("CommunityBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("CommunityBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("community_blocks")
}

// A generic report — targetType + targetId lets one table cover
// post/comment/profile reports without three near-identical models.
// Never auto-actioned: status starts OPEN and only an admin workflow
// (Part 10) moves it to REVIEWED/ACTIONED.
model CommunityReport {
  id         String                    @id @default(uuid())
  reporterId String
  targetType CommunityReportTargetType
  targetId   String
  reason     String                    @db.Text
  status     CommunityReportStatus     @default(OPEN)
  createdAt  DateTime                  @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([status])
  @@map("community_reports")
}

// --- Trainer groups — Founder Scenario 24. Free tier: one group owned
// per user (see common/policy/trainer-group-policy.ts for the single
// source of the owned-group and member-count limits — "not hard-coded
// per-widget" per the scenario), text chat, safe image sharing (same
// media policy as Community — see wellness-ethics-bible.md; no upload
// pipeline or content scanning exists yet, matching Community's Reels),
// shared workout plans, and invitations. Premium-future — more groups,
// larger groups, announcements, and distinct roles — shipped in Build
// Session 9 Part 20, gated on the group OWNER's
// AppCapability.TRAINER_GROUPS_EXPANDED (read fresh per request, same
// "no cached trust" posture as every other capability check in this
// codebase): a Premium owner's group gets the larger limits, can
// promote a MEMBER to MODERATOR (who can then invite/remove members
// and post announcements alongside the owner), and unlocks
// announcements. Still not implemented: scheduled sessions and
// assignments — see parking-lot.md.
enum TrainerGroupMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum TrainerGroupInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

model TrainerGroup {
  id          String   @id @default(uuid())
  ownerId     String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner         User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members       TrainerGroupMember[]
  messages      TrainerGroupMessage[]
  invitations   TrainerGroupInvitation[]
  sharedPlans   TrainerGroupSharedPlan[]
  announcements TrainerGroupAnnouncement[]

  @@index([ownerId])
  @@map("trainer_groups")
}

model TrainerGroupMember {
  id       String                 @id @default(uuid())
  groupId  String
  userId   String
  role     TrainerGroupMemberRole @default(MEMBER)
  joinedAt DateTime               @default(now())

  group TrainerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("trainer_group_members")
}

// One row per group+invitee for all time — a re-invite after a decline/
// cancel updates the existing row back to PENDING rather than creating a
// second row, which keeps "has this person ever been invited" a simple
// unique lookup.
model TrainerGroupInvitation {
  id        String                       @id @default(uuid())
  groupId   String
  inviterId String
  inviteeId String
  status    TrainerGroupInvitationStatus @default(PENDING)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  group   TrainerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter User         @relation("TrainerGroupInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User         @relation("TrainerGroupInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([groupId, inviteeId])
  @@index([inviteeId, status])
  @@map("trainer_group_invitations")
}

// A text message, an image message, or both — never neither (enforced
// in the DTO/service). imageUrl is an externally-hosted URL for the
// same reason CommunityPost.mediaUrl is: no upload pipeline this session.
model TrainerGroupMessage {
  id        String   @id @default(uuid())
  groupId   String
  authorId  String
  body      String?  @db.Text
  imageUrl  String?
  createdAt DateTime @default(now())

  group  TrainerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@map("trainer_group_messages")
}

// A read-only reference to a member's own WorkoutPlan, shared into the
// group — not a copy. If the sharer edits their plan, the group sees the
// update; if they delete it, the share cascades away too.
model TrainerGroupSharedPlan {
  id            String   @id @default(uuid())
  groupId       String
  workoutPlanId String
  sharedById    String
  createdAt     DateTime @default(now())

  group       TrainerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  workoutPlan WorkoutPlan  @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  sharedBy    User         @relation(fields: [sharedById], references: [id], onDelete: Cascade)

  @@unique([groupId, workoutPlanId])
  @@map("trainer_group_shared_plans")
}

// Premium-tier broadcast messages (Build Session 9 Part 20) — only the
// group owner or a MODERATOR can post one, and only when the group
// owner currently holds TRAINER_GROUPS_EXPANDED (checked in
// TrainerGroupsService, not enforced by the schema itself). Kept as its
// own model rather than a flag on TrainerGroupMessage so a group's
// announcement history stays queryable independent of its much
// higher-volume chat history.
model TrainerGroupAnnouncement {
  id        String   @id @default(uuid())
  groupId   String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  group  TrainerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@map("trainer_group_announcements")
}

// --- Rankings and Challenges — Founder Scenario 16a. Opt-in and off by
// default: no RankingOptIn row at all means "private progress only",
// the scenario's default state. This MVP simplifies the scenario's
// full local/city/region/state/national/global granularity down to
// three scopes (FRIENDS/REGION/GLOBAL) — see
// packages/docs/build-session-7.md Part 6 for that scope decision.
// Scoring deliberately never rewards raw volume (weight lifted,
// calories burned) or an uninterrupted streak alone — see
// RankingsService's activity-day scoring for how that's enforced.
// `regionLabel` is the same coarse, user-typed, non-GPS field pattern
// CardioSession.regionLabel already established — never an exact
// coordinate.

enum RankingScope {
  FRIENDS
  REGION
  GLOBAL
}

model RankingOptIn {
  id          String       @id @default(uuid())
  userId      String       @unique
  scope       RankingScope
  regionLabel String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ranking_opt_ins")
}

// A season is just a scoring window — there is no reward/badge system
// yet (Scenario 16a specifies none). `getOrCreateCurrentSeason` in
// RankingsService lazily creates a rolling calendar-month season rather
// than requiring an admin to schedule seasons ahead of time.
model RankingSeason {
  id        String   @id @default(uuid())
  label     String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())

  @@index([startsAt, endsAt])
  @@map("ranking_seasons")
}

// A simple, time-boxed, opt-in-by-joining challenge — any user may
// create one. Progress is measured the same non-gameable "active days"
// way as Rankings (see RankingsService.computeActivitySummary), not by
// any raw-volume metric.
model Challenge {
  id          String   @id @default(uuid())
  creatorId   String
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())

  creator      User                   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  participants ChallengeParticipant[]

  @@index([creatorId])
  @@index([endsAt])
  @@map("challenges")
}

model ChallengeParticipant {
  id          String   @id @default(uuid())
  challengeId String
  userId      String
  joinedAt    DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId])
  @@map("challenge_participants")
}

// Subscription/entitlement foundation — Founder Scenario 27. This model
// exists so CapabilityService.getPlanTier reads a real per-user row
// instead of a hardcoded literal. As of Build Session 9 Part 17/18, a
// verified store Purchase (see below) is the one thing that writes a
// PREMIUM row here — PurchasesService.verifyAndRecord upserts this row
// after a real Apple/Google receipt check succeeds. No row at all means
// FREE (CapabilityService's default), matching every other "absence of
// a row = the private/free default" pattern already established in this
// schema (RankingOptIn, etc).
enum SubscriptionTier {
  FREE
  PREMIUM
}

model UserSubscription {
  id        String           @id @default(uuid())
  userId    String           @unique
  tier      SubscriptionTier @default(FREE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_subscriptions")
}

// Store purchase records — Build Session 9 Part 17/18. One row per
// purchase attempt the client reports; verification against the real
// Apple/Google server is what flips `status` to VERIFIED and (via
// PurchasesService) upserts the buyer's UserSubscription to PREMIUM.
// `platformTransactionId` is unique so the same Apple transaction id or
// Google purchase token can never be redeemed into more than one
// Purchase row, even across different accounts or repeated client
// retries.
enum PurchasePlatform {
  IOS
  ANDROID
}

enum PurchaseStatus {
  PENDING
  VERIFIED
  INVALID
}

model Purchase {
  id                    String           @id @default(uuid())
  userId                String
  platform              PurchasePlatform
  productId             String
  // Apple's original transaction id, or Google's purchase token — the
  // one value each store treats as the durable identity of a purchase.
  platformTransactionId String           @unique
  status                PurchaseStatus   @default(PENDING)
  verifiedAt            DateTime?
  createdAt             DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("purchases")
}

// Affordability programs — Founder Scenario 27's Student/Accessibility/
// Senior/Regional Affordability eligibility model, extending the
// student/disability-access pattern from Scenario 13. Eligibility
// status is deliberately never joined into any public-profile query —
// see CommunityProfile, which has no relation to this model at all.
enum AffordabilityProgram {
  STUDENT
  ACCESSIBILITY
  SENIOR
  REGIONAL
}

enum AffordabilityStatus {
  PENDING
  APPROVED
  REJECTED
}

model AffordabilityEligibility {
  id          String               @id @default(uuid())
  userId      String               @unique
  program     AffordabilityProgram
  status      AffordabilityStatus  @default(PENDING)
  notes       String?
  submittedAt DateTime             @default(now())
  reviewedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("affordability_eligibilities")
}

// Support — Founder Scenario 27. Every category here is free on every
// tier (AppCapability.SUPPORT_ACCESS); none of this is ever
// Premium-gated. One table covers every category the scenario lists
// (help center follow-up, bug reports, safety reports, accessibility
// feedback, account recovery, billing help, moderation appeals) rather
// than one model per category, since they only differ by `category`
// and downstream handling, not by shape.
enum SupportTicketCategory {
  GENERAL
  BUG_REPORT
  SAFETY_REPORT
  ACCESSIBILITY_FEEDBACK
  ACCOUNT_RECOVERY
  BILLING_HELP
  MODERATION_APPEAL
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id         String                @id @default(uuid())
  userId     String
  category   SupportTicketCategory
  subject    String
  message    String                @db.Text
  status     SupportTicketStatus   @default(OPEN)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  resolvedAt DateTime?

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies SupportTicketReply[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model SupportTicketReply {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  // Distinguishes an admin/staff reply from the ticket owner's own
  // follow-up message on the same thread.
  isStaff   Boolean  @default(false)
  body      String   @db.Text
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_ticket_replies")
}

// Ascend Promote — Founder Scenario 23's transparent-promotion
// architecture. Actual billing is future, store-compliant work (no
// live payments this session — see build-session-7.md Part 11); this
// is the architecture a payment integration plugs into. Every
// non-negotiable rule from the scenario is enforced structurally, not
// by convention: a campaign can never serve an impression before an
// admin moves it out of PENDING_REVIEW (PromoteService.recordImpression
// checks status === ACTIVE), paid metrics live in their own tables
// entirely separate from CommunityLike/CommunityComment (so organic and
// paid engagement can never be summed into one blended number by
// accident), and nothing in RankingsService or
// common/scoring/activity-scoring.util.ts ever reads from these tables
// — a paid boost has zero code path into Ranking scoring.
enum PromotedCampaignStatus {
  PENDING_REVIEW
  ACTIVE
  REJECTED
  ENDED
}

model PromotedCampaign {
  id             String                 @id @default(uuid())
  creatorId      String
  postId         String
  status         PromotedCampaignStatus @default(PENDING_REVIEW)
  // Non-final business hypothesis — a spend budget, not a live charge.
  // Same "no live billing" pattern as Scenario 27's pricing config.
  budgetAmount   Float
  budgetCurrency String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  reviewedAt     DateTime?
  reviewedBy     String?
  endedAt        DateTime?

  creator     User                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  post        CommunityPost        @relation(fields: [postId], references: [id], onDelete: Cascade)
  impressions PromotedImpression[]
  clicks      PromotedClick[]

  @@index([status])
  @@index([creatorId])
  @@index([postId])
  @@map("promoted_campaigns")
}

// Deliberately its own table, never a column on CommunityPost or a
// shared row with organic likes/views — see this section's header
// comment on why paid and organic metrics must never be able to blend.
model PromotedImpression {
  id         String   @id @default(uuid())
  campaignId String
  viewerId   String
  createdAt  DateTime @default(now())

  campaign PromotedCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([viewerId, createdAt])
  @@map("promoted_impressions")
}

model PromotedClick {
  id         String   @id @default(uuid())
  campaignId String
  viewerId   String
  createdAt  DateTime @default(now())

  campaign PromotedCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("promoted_clicks")
}

// --- Media Platform (Build Session 8 Part 2). A single upload/storage
// pipeline shared by every feature that accepts a photo/video, instead
// of each module inventing its own. MediaAsset is the durable record;
// MediaUpload is the one-shot upload attempt/contract; MediaVariant
// holds the original plus any derived renditions (thumbnail today,
// transcodes later); MediaUsage decouples "this file exists" from
// "this file is currently attached somewhere" so deleting a Community
// post never deletes a user's private gallery original (Part 6);
// MediaModerationResult is the append-only history behind
// MediaAsset.moderationState.

enum MediaType {
  PROFILE_IMAGE
  COVER_IMAGE
  COMMUNITY_IMAGE
  COMMUNITY_REEL
  CHAT_IMAGE
  MEAL_PHOTO
  PROGRESS_PHOTO
  VISION_CAPTURE
  WORKOUT_SHARE_MEDIA
}

enum MediaVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum MediaProcessingState {
  PENDING
  PROCESSING
  READY
  FAILED
}

// No real ML content classifier exists this session — every asset
// auto-approves on upload completion (matching how a small real MVP
// launches: human review triggered by a report, not pre-screened by a
// model that doesn't exist yet). FLAGGED/REJECTED/REMOVED are reachable
// only through the report → admin-review path, never automatically.
enum MediaModerationState {
  PENDING
  APPROVED
  FLAGGED
  REJECTED
  REMOVED
}

enum MediaRetentionState {
  ACTIVE
  ARCHIVED
  PENDING_DELETION
  DELETED
}

enum MediaUploadState {
  INITIATED
  COMPLETED
  FAILED
  EXPIRED
}

enum MediaVariantType {
  ORIGINAL
  THUMBNAIL
  PREVIEW
}

enum MediaUsageType {
  PROFILE_AVATAR
  PROFILE_COVER
  COMMUNITY_POST
  CHAT_MESSAGE
  MEAL_ENTRY
  PROGRESS_LOG
  GALLERY
  VISION_CAPTURE
  SPORT_MATCH
  WORKOUT_SHARE
}

model MediaAsset {
  id                  String               @id @default(uuid())
  ownerId             String
  mediaType           MediaType
  originalFilename    String
  mimeType            String
  sizeBytes           Int
  width               Int?
  height              Int?
  durationSeconds     Float?
  storageKey          String               @unique
  visibility          MediaVisibility      @default(PRIVATE)
  processingState     MediaProcessingState @default(PENDING)
  moderationState     MediaModerationState @default(PENDING)
  thumbnailStorageKey String?
  createdAt           DateTime             @default(now())
  deletedAt           DateTime?
  retentionState      MediaRetentionState  @default(ACTIVE)

  owner              User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  upload             MediaUpload?
  variants           MediaVariant[]
  usages             MediaUsage[]
  moderationResults  MediaModerationResult[]
  messageAttachments MessageAttachment[]
  galleryMedia       GalleryMedia[]
  avatarForProfiles  CommunityProfile[]      @relation("CommunityProfileAvatar")
  coverForProfiles   CommunityProfile[]      @relation("CommunityProfileCover")

  @@index([ownerId, createdAt])
  @@index([moderationState])
  @@index([mediaType, ownerId])
  @@map("media_assets")
}

// Build Session 9 Part 2 — a private-by-default personal gallery built
// entirely on top of the existing Media Platform (MediaAsset/MediaUsage
// above); this module owns no storage of its own. Categories are the
// exact set from user-scenario-bible.md's profile-media requirements —
// SHARED and PRIVATE describe the album's own state as much as a topic,
// which is intentional: an album's category and its visibility are
// tracked separately (see GalleryVisibility) so "Shared" as a category
// doesn't have to mean every photo in it is actually shared.
enum GalleryCategory {
  PROGRESS
  WORKOUTS
  MEALS
  CARDIO
  ACHIEVEMENTS
  VISION
  SHARED
  PRIVATE
}

enum GalleryVisibility {
  PRIVATE
  SHARED
}

// Standardized angles for progress photos — user-scenario-bible.md's
// front/side/back tagging. Optional and only meaningful on PROGRESS
// media; nothing forces a photo in a PROGRESS album to be tagged.
enum GalleryPoseTag {
  FRONT
  SIDE
  BACK
}

model GalleryAlbum {
  id         String            @id @default(uuid())
  ownerId    String
  name       String
  category   GalleryCategory   @default(PRIVATE)
  visibility GalleryVisibility @default(PRIVATE)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  owner User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  media GalleryMedia[]

  @@index([ownerId, createdAt])
  @@map("gallery_albums")
}

model GalleryMedia {
  id           String          @id @default(uuid())
  albumId      String
  mediaAssetId String
  note         String?
  poseTag      GalleryPoseTag?
  // A user-typed note, never a measured/derived value — see the
  // wellness-ethics-bible.md rule this mirrors elsewhere: Ascend never
  // infers or calculates a body metric on the user's behalf.
  weightNote   String?
  capturedAt   DateTime?
  createdAt    DateTime        @default(now())

  album      GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset   @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([albumId, createdAt])
  @@index([mediaAssetId])
  @@map("gallery_media")
}

// One row per upload attempt. A fresh MediaAsset+MediaUpload pair is
// created every time `initiateUpload` is called — retrying a failed
// upload starts a new pair rather than reusing an expired contract.
model MediaUpload {
  id              String           @id @default(uuid())
  mediaAssetId    String           @unique
  state           MediaUploadState @default(INITIATED)
  storageProvider String
  uploadMethod    String
  expiresAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime         @default(now())

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@map("media_uploads")
}

model MediaVariant {
  id           String           @id @default(uuid())
  mediaAssetId String
  variantType  MediaVariantType
  storageKey   String
  width        Int?
  height       Int?
  sizeBytes    Int?
  mimeType     String
  createdAt    DateTime         @default(now())

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, variantType])
  @@map("media_variants")
}

model MediaUsage {
  id           String         @id @default(uuid())
  mediaAssetId String
  usageType    MediaUsageType
  // The id of the CommunityPost / DirectMessage / MealEntry / etc. this
  // asset is currently attached to. Deliberately not a typed foreign
  // key — MediaUsage exists precisely so Media doesn't need to know
  // about every module that might attach it.
  referenceId  String
  attachedAt   DateTime       @default(now())

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([mediaAssetId])
  @@index([usageType, referenceId])
  @@map("media_usages")
}

model MediaModerationResult {
  id           String               @id @default(uuid())
  mediaAssetId String
  status       MediaModerationState
  reasonCode   String?
  reviewedBy   String?
  notes        String?
  createdAt    DateTime             @default(now())

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([mediaAssetId, createdAt])
  @@map("media_moderation_results")
}

// --- Friendship system (Build Session 8 Part 7). Deliberately separate
// from CommunityFollow — following is one-directional and public-facing
// (a creator/audience relationship); a Friendship is mutual, gates
// direct messaging without a message request (Part 8), and gates
// friend-only joint workout invites (Part 9). Nothing here
// auto-converts a follow into a friendship.

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
  EXPIRED
}

model FriendRequest {
  id          String              @id @default(uuid())
  senderId    String
  recipientId String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  sender    User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("FriendRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status])
  @@index([senderId, status])
  @@map("friend_requests")
}

// Undirected — always stored with userAId < userBId (see
// common/friendship/friendship-pair.util.ts) so a unique constraint on
// the pair actually prevents a duplicate row in either direction.
model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("friendships")
}

// --- Direct Messaging (Build Session 8 Part 8). Database-first — a
// message is durable the moment it's written; a realtime WebSocket
// gateway (see modules/messages/messages.gateway.ts) pushes new-message
// events to connected clients as a convenience layer, never a
// requirement (the Flutter client also polls, per the "do not require
// realtime transport for messages to remain durable" rule). A
// conversation with someone the caller isn't friends with starts as a
// PENDING "message request" — the initiator may send exactly one
// message before the recipient explicitly accepts/declines, which is
// how "no unrestricted attachment spam" is actually enforced.

enum DirectConversationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model DirectConversation {
  id            String                   @id @default(uuid())
  status        DirectConversationStatus @default(ACCEPTED)
  initiatorId   String
  createdAt     DateTime                 @default(now())
  lastMessageAt DateTime?

  initiator    User                            @relation("DirectConversationInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  participants DirectConversationParticipant[]
  messages     DirectMessage[]

  @@map("direct_conversations")
}

model DirectConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  mutedAt        DateTime?
  // "Delete for self" — hides the conversation for this participant
  // only; a new incoming message clears it so the thread reappears
  // rather than silently vanishing forever.
  deletedAt      DateTime?
  lastReadAt     DateTime?

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("direct_conversation_participants")
}

enum DirectMessageType {
  TEXT
  IMAGE
  WORKOUT_SHARE
  MEAL_SHARE
  ACHIEVEMENT_SHARE
  CARDIO_SHARE
}

model DirectMessage {
  id                String            @id @default(uuid())
  conversationId    String
  senderId          String
  type              DirectMessageType @default(TEXT)
  body              String?           @db.Text
  replyToId         String?
  // For a *_SHARE type — the id of the WorkoutSession/MealEntry/
  // AchievementAward/CardioSession being shared. The recipient's client
  // resolves it through that module's own read endpoint; nothing here
  // duplicates the shared record's data.
  sharedReferenceId String?
  createdAt         DateTime          @default(now())
  deletedAt         DateTime?

  conversation DirectConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      DirectMessage?      @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      DirectMessage[]     @relation("MessageReply")
  attachments  MessageAttachment[]
  receipts     MessageReceipt[]
  reports      MessageReport[]

  @@index([conversationId, createdAt])
  @@map("direct_messages")
}

model MessageAttachment {
  id           String   @id @default(uuid())
  messageId    String
  mediaAssetId String
  createdAt    DateTime @default(now())

  message    DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset    @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

enum MessageReceiptStatus {
  DELIVERED
  READ
}

model MessageReceipt {
  id        String               @id @default(uuid())
  messageId String
  userId    String
  status    MessageReceiptStatus
  at        DateTime             @default(now())

  message DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, status])
  @@map("message_receipts")
}

model MessageReport {
  id         String   @id @default(uuid())
  messageId  String
  reporterId String
  reason     String
  createdAt  DateTime @default(now())

  message  DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("message_reports")
}

// --- Joint Workout Sessions — Build Session 8 Part 9. Friend-only: every
// invite requires the host and invitee to already be Friends (see
// FriendsService.areFriends), never open to strangers. JointWorkoutSharedResult
// is a deliberately narrow whitelist — sets/duration/exercises/PRs/distance
// only. It must never carry weight, BMI, health conditions, nutrition,
// heart rate, or wearable metrics; JointWorkoutSessionService only ever
// writes fields from that whitelist, and no other table's health data is
// joined into a session response.

enum JointWorkoutSessionStatus {
  CREATED
  IN_PROGRESS
  FINISHED
  CANCELED
}

enum JointWorkoutParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
  READY
  ACTIVE
  FINISHED
  LEFT
}

model JointWorkoutSession {
  id         String                    @id @default(uuid())
  hostId     String
  title      String?
  status     JointWorkoutSessionStatus @default(CREATED)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?
  canceledAt DateTime?

  host         User                      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  participants JointWorkoutParticipant[]
  events       JointWorkoutEvent[]

  @@index([hostId])
  @@map("joint_workout_sessions")
}

model JointWorkoutParticipant {
  id          String                        @id @default(uuid())
  sessionId   String
  userId      String
  status      JointWorkoutParticipantStatus @default(INVITED)
  invitedAt   DateTime                      @default(now())
  respondedAt DateTime?
  readyAt     DateTime?
  finishedAt  DateTime?
  leftAt      DateTime?

  session JointWorkoutSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  results JointWorkoutSharedResult[]

  @@unique([sessionId, userId])
  @@index([userId, status])
  @@map("joint_workout_participants")
}

// Sets/duration/exercises/PRs/distance only — see the doc comment above
// this section. No column here may ever hold weight, BMI, a health
// condition, nutrition data, heart rate, or a wearable metric.
model JointWorkoutSharedResult {
  id               String   @id @default(uuid())
  participantId    String
  exerciseName     String?
  setsCompleted    Int?
  durationSeconds  Int?
  distanceMeters   Float?
  isPersonalRecord Boolean  @default(false)
  createdAt        DateTime @default(now())

  participant JointWorkoutParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@map("joint_workout_shared_results")
}

enum JointWorkoutEventType {
  INVITED
  ACCEPTED
  DECLINED
  READY
  STARTED
  PROGRESS
  FINISHED
  LEFT
  CANCELED
}

// A lightweight, append-only activity feed for a session (e.g. "Bea is
// ready", "Ada finished Squat: 3 sets") — purely derived from the
// whitelisted fields above, never a health-data channel of its own.
model JointWorkoutEvent {
  id        String                @id @default(uuid())
  sessionId String
  userId    String?
  type      JointWorkoutEventType
  message   String?
  createdAt DateTime              @default(now())

  session JointWorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@map("joint_workout_events")
}

// --- Sports Match System — Build Session 8 Part 10. 1v1 matches with a
// dual-confirmation score flow: either participant proposes a final
// score, and the match only becomes CONFIRMED (and only then affects
// SportRating) once the *other* participant confirms it — proposing and
// confirming your own score is rejected. A disagreement raises a
// SportMatchDispute rather than silently picking a side; either
// participant may then either re-propose a score or void the match.
// SportsService's collusion heuristic only ever sets `flagged`/
// `flagReason` for later manual review — it never bans, restricts, or
// auto-resolves anything.

enum SportCode {
  BADMINTON
}

model Sport {
  id   String    @id @default(uuid())
  code SportCode @unique
  name String

  ruleSets SportRuleSet[]
  matches  SportMatch[]
  ratings  SportRating[]

  @@map("sports")
}

model SportRuleSet {
  id             String @id @default(uuid())
  sportId        String
  name           String
  pointsToWinSet Int
  setsToWin      Int

  sport   Sport        @relation(fields: [sportId], references: [id], onDelete: Cascade)
  matches SportMatch[]

  @@index([sportId])
  @@map("sport_rule_sets")
}

enum SportMatchStatus {
  CREATED
  INVITED
  READY
  IN_PROGRESS
  SCORE_PENDING
  DISPUTED
  CONFIRMED
  CANCELED
  VOID
}

model SportMatch {
  id          String           @id @default(uuid())
  sportId     String
  ruleSetId   String?
  createdById String
  status      SportMatchStatus @default(CREATED)
  // Set only by SportsService's anti-collusion heuristic — see this
  // section's doc comment. Never causes an automatic ban or restriction.
  flagged     Boolean          @default(false)
  flagReason  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  startedAt   DateTime?
  confirmedAt DateTime?
  canceledAt  DateTime?
  voidedAt    DateTime?

  sport          Sport                   @relation(fields: [sportId], references: [id], onDelete: Cascade)
  ruleSet        SportRuleSet?           @relation(fields: [ruleSetId], references: [id], onDelete: SetNull)
  createdBy      User                    @relation(fields: [createdById], references: [id], onDelete: Cascade)
  participants   SportMatchParticipant[]
  scoreProposals SportScoreProposal[]
  disputes       SportMatchDispute[]

  @@index([createdById])
  @@index([sportId, status])
  @@map("sport_matches")
}

enum SportMatchParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
  READY
  LEFT
}

model SportMatchParticipant {
  id          String                      @id @default(uuid())
  matchId     String
  userId      String
  status      SportMatchParticipantStatus @default(INVITED)
  invitedAt   DateTime                    @default(now())
  respondedAt DateTime?
  readyAt     DateTime?

  match SportMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId, status])
  @@map("sport_match_participants")
}

enum SportScoreProposalStatus {
  PENDING
  CONFIRMED
  REJECTED
  SUPERSEDED
}

model SportScoreProposal {
  id            String                   @id @default(uuid())
  matchId       String
  proposedById  String
  // Scores are relative to the proposer, never to a fixed "home/away"
  // slot, since a 1v1 match has no fixed sides.
  proposerScore Int
  opponentScore Int
  status        SportScoreProposalStatus @default(PENDING)
  createdAt     DateTime                 @default(now())

  match        SportMatch              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  proposedBy   User                    @relation(fields: [proposedById], references: [id], onDelete: Cascade)
  confirmation SportScoreConfirmation?

  @@index([matchId, status])
  @@map("sport_score_proposals")
}

model SportScoreConfirmation {
  id            String   @id @default(uuid())
  proposalId    String   @unique
  confirmedById String
  createdAt     DateTime @default(now())

  proposal    SportScoreProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  confirmedBy User               @relation(fields: [confirmedById], references: [id], onDelete: Cascade)

  @@map("sport_score_confirmations")
}

model SportMatchDispute {
  id         String    @id @default(uuid())
  matchId    String
  raisedById String
  reason     String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  match    SportMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  raisedBy User       @relation(fields: [raisedById], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@map("sport_match_disputes")
}

// Elo-like, with a provisional period (the first few matches use a
// higher K-factor and isProvisional stays true) so a new player's rating
// converges quickly rather than being anchored by early results.
model SportRating {
  id            String   @id @default(uuid())
  userId        String
  sportId       String
  rating        Float    @default(1500)
  isProvisional Boolean  @default(true)
  matchesPlayed Int      @default(0)
  updatedAt     DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([userId, sportId])
  @@index([sportId, rating])
  @@map("sport_ratings")
}

// --- Ascend Nutrition Library — Build Session 8 Part 11. Free on every
// tier (see AppCapability.nutritionLibrary). General nutrition
// education only — every NutrientArticle carries a safetyNote and
// NutritionLibraryService's seed content never diagnoses a condition or
// prescribes a specific supplement dose. References cite an
// organization/publication by name only (no generated URLs).

enum NutrientCategoryCode {
  MACRONUTRIENT
  MINERAL
  VITAMIN
}

model NutrientCategory {
  id          String               @id @default(uuid())
  code        NutrientCategoryCode @unique
  name        String
  description String

  articles NutrientArticle[]

  @@map("nutrient_categories")
}

model NutrientArticle {
  id         String   @id @default(uuid())
  categoryId String
  slug       String   @unique
  title      String
  summary    String
  body       String   @db.Text
  // Always present — see this section's doc comment.
  safetyNote String   @db.Text
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category    NutrientCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  foodSources NutrientFoodSource[]
  references  NutrientReference[]
  savedBy     SavedNutrientArticle[]

  @@index([categoryId])
  @@map("nutrient_articles")
}

// A display-ready amount string (e.g. "26g protein per 100g") rather
// than a raw number + unit pair — this library is educational content,
// not a food-logging data source (see the Meal Prep / Food models for
// that), so it never needs unit conversion.
model NutrientFoodSource {
  id        String @id @default(uuid())
  articleId String
  foodName  String
  amount    String
  sortOrder Int    @default(0)

  article NutrientArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("nutrient_food_sources")
}

model NutrientReference {
  id        String @id @default(uuid())
  articleId String
  label     String
  sortOrder Int    @default(0)

  article NutrientArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("nutrient_references")
}

model SavedNutrientArticle {
  id        String   @id @default(uuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  article NutrientArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@map("saved_nutrient_articles")
}

// --- Notifications — Build Session 8 Part 12. Reminders
// (workout/rest-day/water/meal) and social notifications (achievement/
// friend-request/message/group-invite/challenge/joint-workout/sports-
// match) share one NotificationEvent log. `Preference.notificationsEnabled`
// remains the master switch (unchanged from an earlier session);
// NotificationPreference adds granular per-category toggles checked on
// top of it — see NotificationsService.isEnabledFor. Delivery goes
// through PushNotificationProvider/LocalNotificationProvider
// abstractions (see notifications/providers/*.ts) so this never
// requires real Firebase/APNs credentials to run or test. Copy for
// every reminder type must stay encouraging, never guilt-based — e.g.
// "Ready for today's workout?" rather than "You haven't worked out in
// 3 days."

enum NotificationType {
  WORKOUT_REMINDER
  REST_DAY_REMINDER
  WATER_REMINDER
  MEAL_REMINDER
  ACHIEVEMENT_UNLOCKED
  FRIEND_REQUEST
  DIRECT_MESSAGE
  GROUP_INVITE
  CHALLENGE
  JOINT_WORKOUT
  SPORTS_MATCH
}

model NotificationPreference {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  workoutReminders         Boolean  @default(true)
  restDayReminders         Boolean  @default(true)
  waterReminders           Boolean  @default(true)
  mealReminders            Boolean  @default(true)
  achievementNotifications Boolean  @default(true)
  socialNotifications      Boolean  @default(true)
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationEvent {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  // Free-form context for the client to deep-link with, e.g. a
  // conversationId or matchId — never a health metric.
  data      String?
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notification_events")
}

enum NotificationChannel {
  PUSH
  LOCAL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model NotificationDelivery {
  id            String                     @id @default(uuid())
  eventId       String
  channel       NotificationChannel
  status        NotificationDeliveryStatus @default(PENDING)
  attemptedAt   DateTime                   @default(now())
  deliveredAt   DateTime?
  failureReason String?

  event NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("notification_deliveries")
}

// Build Session 10 Part 12 — one row per device the user has granted
// push permission on. `token` is unique because a provider-issued push
// token belongs to exactly one installation at a time; re-registering
// the same token (e.g. after a reinstall under a different account)
// moves it to the newly-registering user rather than creating a
// duplicate. Consumed by FcmPushNotificationProvider — never returned
// to any client beyond the registration call itself.
model PushDeviceToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  // Freeform client-reported platform ("ios" | "android"), purely
  // informational — never used for any security decision.
  platform   String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_device_tokens")
}

// Build Session 10 Part 15 — real, durable Atlas/Nova memory, tied to
// the `Preference.aiMemoryEnabled` toggle that already existed but was
// never read anywhere (see roadmap.md's "AI gateway" section). `notes`
// is a small, capped list of the user's own substantive statements
// (goals, injuries, equipment, preferences), stored verbatim — never an
// LLM-generated summary — so nothing here is ever a fabricated or
// misremembered fact, matching the "never invent" rule used elsewhere
// in the assistant/research pipeline. AssistantService caps and prunes
// this list; the schema itself places no limit.
model CompanionMemory {
  id        String   @id @default(uuid())
  userId    String   @unique
  notes     String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("companion_memories")
}

// Build Session 10 Part 6 — private, user-owned results from a live
// on-device pose-analysis session (Form Coach / Rep Counter, Part 2-5).
// One row per session rather than the separately-suggested
// Session/ExerciseResult/RepResult split: V1 always analyzes exactly one
// exercise per live session (see SupportedExercise), so a per-exercise
// child table would be empty normalization overhead this app doesn't
// need yet — the exercise/rep-count fields live directly on the session
// row instead. `mediaAssetId`/`workoutSessionId` are deliberately loose
// references (no typed Prisma relation), matching MediaUsage's existing
// "don't make MediaAsset know about every consumer" precedent — see
// MediaUsage's doc comment above.
enum VisionExercise {
  BODYWEIGHT_SQUAT
  BICEPS_CURL
  SHOULDER_PRESS
}

enum FormObservationSeverity {
  INFO
  COACHING_CUE
  CHECK_FORM
}

model VisionAnalysisSession {
  id                String         @id @default(uuid())
  userId            String
  exercise          VisionExercise
  startedAt         DateTime
  completedAt       DateTime?
  // The analyzer's own count vs. the count after any manual +1/-1
  // correction — kept separate so a user's correction is visible as a
  // correction, never silently overwriting what was actually detected.
  autoRepCount      Int
  correctedRepCount Int
  // A short tag for which analyzer build produced this result (e.g.
  // "pose-v1") — lets a future analyzer change be distinguished from
  // this one in stored history without guessing from the date alone.
  analysisVersion   String
  // Loose references, not typed relations — see the model group's doc
  // comment above.
  mediaAssetId      String?
  workoutSessionId  String?
  createdAt         DateTime       @default(now())

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  observations VisionFormObservation[]

  @@index([userId, createdAt])
  @@index([userId, exercise])
  @@map("vision_analysis_sessions")
}

model VisionFormObservation {
  id         String                  @id @default(uuid())
  sessionId  String
  // A short machine-stable identifier (e.g. "squat_depth",
  // "knee_tracking") — see FormObservation's doc comment on the Flutter
  // side for why this is distinct from the human-readable message.
  type       String
  message    String
  severity   FormObservationSeverity
  confidence Float
  occurredAt DateTime

  session VisionAnalysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("vision_form_observations")
}
