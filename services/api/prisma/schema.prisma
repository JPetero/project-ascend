// Project Ascend — Prisma schema
// Portability note: `daysOfWeek` on WorkoutSchedule uses a native PostgreSQL
// text array (String[]) rather than a normalized child table. This is the
// more portable choice for a small, bounded, order-insensitive set of values
// (day names) that is always read/written as a whole with its parent record —
// it avoids a join for a field that is never queried independently, while
// remaining simple to migrate later if per-day metadata is ever needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum SexForCalculations {
  MALE
  FEMALE
  UNSPECIFIED
}

enum Companion {
  ATLAS
  NOVA
}

// Coaching style is independent of companion choice (Atlas/Nova) — see
// packages/docs/product/atlas-nova-bible.md. TOUGH must never insult, shame,
// or override safety rules; it's intensity of delivery, not permission to
// be unsafe.
enum CoachingStyle {
  GENTLE
  BALANCED
  DIRECT
  TOUGH
  ATHLETE
}

enum CompanionMode {
  STANDARD
  CHIBI
}

enum ThemeMode {
  SYSTEM
  LIGHT
  DARK
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum LegalDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
}

enum DeviceConnectionStatus {
  CONNECTED
  DISCONNECTED
  PENDING
  ERROR
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens         RefreshToken[]
  profile               Profile?
  preference            Preference?
  equipment             Equipment[]
  workoutSchedule       WorkoutSchedule?
  devices               DeviceConnection[]
  auditEvents           AuditEvent[]
  workoutPlans          WorkoutPlan[]
  workoutSessions       WorkoutSession[]
  personalRecords       PersonalRecord[]
  syncOperations        SyncOperation[]
  ownedFoods            Food[]
  mealEntries           MealEntry[]
  macroTarget           MacroTarget?
  waterEntries          WaterEntry[]
  authIdentities        AuthIdentity[]
  legalAcceptances      LegalAcceptance[]
  deloadRecommendations DeloadRecommendation[]
  savedMeals            SavedMeal[]
  achievementAwards     AchievementAward[]
  cardioSessions        CardioSession[]

  @@index([status])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  // Shared by every token descended from the same login/register — i.e. the
  // original token and every token it was rotated into. Lets us revoke an
  // entire session lineage at once when reuse of an already-rotated token
  // indicates possible theft (see AuthService.handleRefreshTokenReuse).
  familyId   String
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  // Set only when this specific token was revoked as part of family-wide
  // reuse handling (AuthService.handleRefreshTokenReuse), never on an
  // ordinary rotation revoke — lets an auditor distinguish "rotated
  // normally" from "killed because a stolen/replayed token surfaced" just
  // by reading the row, without needing the AuditEvent log.
  reusedAt   DateTime?
  deviceName String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Profile {
  id                  String             @id @default(uuid())
  userId              String             @unique
  firstName           String
  dateOfBirth         DateTime?
  countryCode         String?
  languageCode        String             @default("en")
  timezone            String             @default("UTC")
  unitSystem          UnitSystem         @default(METRIC)
  sexForCalculations  SexForCalculations @default(UNSPECIFIED)
  heightCm            Float?
  weightKg            Float?
  primaryGoal         String?
  experienceLevel     String?
  onboardingCompleted Boolean            @default(false)
  onboardingStep      Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Preference {
  id                   String        @id @default(uuid())
  userId               String        @unique
  companion            Companion     @default(ATLAS)
  companionMode        CompanionMode @default(STANDARD)
  // Independent of `companion` by design — see
  // packages/docs/product/atlas-nova-bible.md. Neither Atlas nor Nova is
  // "for" a given coaching style.
  coachingStyle        CoachingStyle @default(BALANCED)
  // 1 (softest) - 5 (most intense) delivery of the selected coachingStyle.
  // Never changes what's safe to recommend, only how it's phrased.
  toneIntensity        Int           @default(3)
  themeMode            ThemeMode     @default(SYSTEM)
  reducedMotion        Boolean       @default(false)
  notificationsEnabled Boolean       @default(true)
  aiMemoryEnabled      Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("preferences")
}

model Equipment {
  id         String  @id @default(uuid())
  userId     String
  type       String
  customName String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("equipment")
}

model WorkoutSchedule {
  id              String   @id @default(uuid())
  userId          String   @unique
  durationMinutes Int
  preferredTime   String?
  daysOfWeek      String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workout_schedules")
}

model DeviceConnection {
  id                String                 @id @default(uuid())
  userId            String
  provider          String
  // Distinguishes multiple physical devices from the same provider (e.g.
  // two paired Garmin watches). Defaults to the literal "default" when the
  // client doesn't supply one, which preserves the original one-connection-
  // per-provider behavior for providers/clients that don't yet track a
  // real per-device identifier — see packages/docs/build-session-1.md for
  // the reasoning.
  connectionKey     String                 @default("default")
  displayName       String
  status            DeviceConnectionStatus @default(PENDING)
  externalAccountId String?
  lastSyncedAt      DateTime?
  metadata          Json                   @default("{}")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, connectionKey])
  @@index([userId])
  @@index([provider])
  @@map("device_connections")
}

model AuditEvent {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Workout Engine (Sprint 2)
// ---------------------------------------------------------------------------
// Two-tier workout model, the same shape as most content-catalog systems:
//   - Workout / WorkoutExercise: a shared, curated catalog (seeded, not
//     user-owned) that the "Browse workouts" surface reads.
//   - WorkoutPlan / WorkoutPlanExercise: a user's own plan. Starting a plan
//     "from" a catalog Workout copies its exercises in rather than
//     referencing them live, so a user customizing their plan (reordering,
//     changing target sets/reps) never mutates the shared catalog.
//
// There is deliberately no `WorkoutHistory` table. "History" is a read
// model — a query over completed `WorkoutSession`/`WorkoutSet` rows, served
// by the history module's service — not a separate table that would just be
// another copy of the same facts to keep in sync for no query benefit.
//
// Weight/duration/distance are always stored in canonical metric units
// (kg / seconds / meters), the same convention `Profile.heightCm` and
// `Profile.weightKg` already use — the client converts for display based on
// `Preference.unitSystem` (not modeled here; conversion is presentation-only).

enum ExerciseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MuscleRole {
  PRIMARY
  SECONDARY
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
  ABANDONED
}

enum PersonalRecordType {
  MAX_WEIGHT
  MAX_REPS
  MAX_DURATION
  MAX_DISTANCE
  MAX_VOLUME
  // Epley-formula estimate from a single completed set (see
  // ProgressionService docs) — always presented to the user as an
  // estimate, never a measured max.
  ESTIMATED_ONE_REP_MAX
  // Fastest meters-per-second across a session's distance+duration sets;
  // only ever computed when both values are present and valid.
  BEST_PACE
}

// Controls which of WorkoutSet's optional fields are meaningful for a given
// exercise, and which input controls the Workout Player shows. Deliberately
// excludes a CALORIES option — see build-session-1.md's P1.1 entry for why
// (no real estimation pipeline exists yet, and a fabricated calorie number
// would violate the "no fake health data" rule).
enum MeasurementType {
  REPS_WEIGHT
  REPS_ONLY
  DURATION
  DISTANCE_DURATION
  ASSISTED_WEIGHT
  BODYWEIGHT
}

model ExerciseCategory {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  exercises Exercise[]
  workouts  Workout[]

  @@map("exercise_categories")
}

model MuscleGroup {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  exerciseMuscles ExerciseMuscle[]

  @@map("muscle_groups")
}

model EquipmentType {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  exerciseEquipment ExerciseEquipment[]

  @@map("equipment_types")
}

model Exercise {
  id              String             @id @default(uuid())
  name            String
  slug            String             @unique
  description     String
  difficulty      ExerciseDifficulty @default(BEGINNER)
  measurementType MeasurementType    @default(REPS_WEIGHT)
  instructions    String
  safetyTips      String
  commonMistakes  String
  // Placeholders only in this sprint — no media pipeline yet (see
  // packages/docs/roadmap.md). Nullable so seed data can omit them without
  // every exercise needing a fake URL.
  imageUrl        String?
  videoUrl        String?
  categoryId      String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  category  ExerciseCategory    @relation(fields: [categoryId], references: [id])
  muscles   ExerciseMuscle[]
  equipment ExerciseEquipment[]

  alternativesFrom ExerciseAlternative[] @relation("ExerciseAlternativesFrom")
  alternativesTo   ExerciseAlternative[] @relation("ExerciseAlternativesTo")

  workoutExercises     WorkoutExercise[]
  workoutPlanExercises WorkoutPlanExercise[]
  workoutSets          WorkoutSet[]
  personalRecords      PersonalRecord[]

  substitutionsAsOriginal   WorkoutSessionSubstitution[] @relation("SubstitutionOriginal")
  substitutionsAsSubstitute WorkoutSessionSubstitution[] @relation("SubstitutionReplacement")

  @@index([categoryId])
  @@map("exercises")
}

model ExerciseMuscle {
  id            String     @id @default(uuid())
  exerciseId    String
  muscleGroupId String
  role          MuscleRole

  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroup MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, muscleGroupId])
  @@index([muscleGroupId])
  @@map("exercise_muscles")
}

model ExerciseEquipment {
  id              String @id @default(uuid())
  exerciseId      String
  equipmentTypeId String

  exercise      Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, equipmentTypeId])
  @@index([equipmentTypeId])
  @@map("exercise_equipment")
}

// Seed data inserts both directions explicitly (A->B and B->A) rather than
// making every read infer the reverse relationship — simpler queries, at
// the cost of seed data needing to keep both directions consistent.
model ExerciseAlternative {
  id                    String @id @default(uuid())
  exerciseId            String
  alternativeExerciseId String

  exercise            Exercise @relation("ExerciseAlternativesFrom", fields: [exerciseId], references: [id], onDelete: Cascade)
  alternativeExercise Exercise @relation("ExerciseAlternativesTo", fields: [alternativeExerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, alternativeExerciseId])
  @@index([alternativeExerciseId])
  @@map("exercise_alternatives")
}

model Workout {
  id                       String             @id @default(uuid())
  name                     String
  slug                     String             @unique
  description              String
  categoryId               String
  difficulty               ExerciseDifficulty @default(BEGINNER)
  estimatedDurationMinutes Int
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  category  ExerciseCategory  @relation(fields: [categoryId], references: [id])
  exercises WorkoutExercise[]
  plans     WorkoutPlan[]

  @@index([categoryId])
  @@map("workouts")
}

model WorkoutExercise {
  id                    String  @id @default(uuid())
  workoutId             String
  exerciseId            String
  order                 Int
  targetSets            Int
  targetReps            Int?
  targetDurationSeconds Int?
  targetWeightKg        Float?
  targetDistanceMeters  Float?
  restSeconds           Int     @default(60)
  notes                 String?

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([workoutId, order])
  @@index([exerciseId])
  @@map("workout_exercises")
}

model WorkoutPlan {
  id          String    @id @default(uuid())
  userId      String
  // The catalog Workout this plan started from, if any — kept only as a
  // "based on" reference; WorkoutPlanExercise rows are this plan's own
  // copy, so the plan is unaffected if the catalog Workout later changes.
  workoutId   String?
  name        String
  description String?
  // Soft-delete: archived plans are hidden from the default plan list but
  // never physically removed, so past sessions started from them keep a
  // resolvable `workoutPlan` relation. `DELETE /workout-plans/:id` still
  // exists for a true hard delete when nothing references the plan.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout   Workout?              @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  exercises WorkoutPlanExercise[]
  sessions  WorkoutSession[]

  @@index([userId])
  @@map("workout_plans")
}

model WorkoutPlanExercise {
  id                    String  @id @default(uuid())
  workoutPlanId         String
  exerciseId            String
  order                 Int
  targetSets            Int
  targetReps            Int?
  targetDurationSeconds Int?
  targetWeightKg        Float?
  targetDistanceMeters  Float?
  restSeconds           Int     @default(60)
  notes                 String?

  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercise    Exercise    @relation(fields: [exerciseId], references: [id])

  @@unique([workoutPlanId, order])
  @@index([exerciseId])
  @@map("workout_plan_exercises")
}

model WorkoutSession {
  id                    String               @id @default(uuid())
  userId                String
  workoutPlanId         String?
  status                WorkoutSessionStatus @default(IN_PROGRESS)
  startedAt             DateTime             @default(now())
  // Start of the *current* active streak — set on start() and every
  // resume(). pause()/finish() add (now - resumedAt) to
  // activeDurationSeconds before clearing/ignoring it, which is what makes
  // multiple pause/resume cycles accumulate correctly instead of just the
  // last streak.
  resumedAt             DateTime             @default(now())
  pausedAt              DateTime?
  completedAt           DateTime?
  // Accumulated active seconds, excluding paused time — updated on
  // pause/resume/finish rather than derived from completedAt - startedAt,
  // since that delta would incorrectly include any paused time.
  activeDurationSeconds Int                  @default(0)
  notes                 String?
  // Optional whole-session difficulty rating, same 1-10 scale as per-set
  // RPE, entered once at finish() rather than per set.
  difficultyRating      Int?
  createdAt             DateTime             @default(now())

  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutPlan     WorkoutPlan?                 @relation(fields: [workoutPlanId], references: [id], onDelete: SetNull)
  sets            WorkoutSet[]
  personalRecords PersonalRecord[]
  substitutions   WorkoutSessionSubstitution[]

  @@index([userId])
  @@index([userId, status])
  @@index([workoutPlanId])
  @@map("workout_sessions")
}

// Records that, within one session, sets logged against `originalExerciseId`
// should from now on be logged against `substituteExerciseId` instead.
// Deliberately does NOT touch already-created `WorkoutSet` rows — those
// keep referencing whichever exercise they were actually logged against,
// so completed history is never rewritten. One active substitution per
// (session, original exercise): substituting again just replaces it.
model WorkoutSessionSubstitution {
  id                   String   @id @default(uuid())
  workoutSessionId     String
  originalExerciseId   String
  substituteExerciseId String
  createdAt            DateTime @default(now())

  workoutSession     WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  originalExercise   Exercise       @relation("SubstitutionOriginal", fields: [originalExerciseId], references: [id])
  substituteExercise Exercise       @relation("SubstitutionReplacement", fields: [substituteExerciseId], references: [id])

  @@unique([workoutSessionId, originalExerciseId])
  @@index([workoutSessionId])
  @@map("workout_session_substitutions")
}

model WorkoutSet {
  id               String   @id @default(uuid())
  workoutSessionId String
  exerciseId       String
  setNumber        Int
  reps             Int?
  weightKg         Float?
  durationSeconds  Int?
  distanceMeters   Float?
  // Rate of Perceived Exertion, 1-10, half-point increments allowed (e.g.
  // 7.5) — the standard resolution most RPE scales use. Optional and
  // purely subjective; never treated as a medical measurement. See
  // ProgressionService for how it tempers (but never blocks) a load
  // increase.
  rpe              Float?
  isWarmup         Boolean  @default(false)
  completedAt      DateTime @default(now())

  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise       Exercise       @relation(fields: [exerciseId], references: [id])

  @@unique([workoutSessionId, exerciseId, setNumber])
  @@index([exerciseId])
  @@map("workout_sets")
}

model PersonalRecord {
  id               String             @id @default(uuid())
  userId           String
  exerciseId       String
  type             PersonalRecordType
  value            Float
  unit             String
  workoutSessionId String?
  achievedAt       DateTime           @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise       Exercise        @relation(fields: [exerciseId], references: [id])
  workoutSession WorkoutSession? @relation(fields: [workoutSessionId], references: [id], onDelete: SetNull)

  // One current-best row per (user, exercise, category) — broken records
  // are updated in place, not appended. The session/date it was set on is
  // still recoverable from `workoutSessionId` / `achievedAt`; a full
  // append-only PR log isn't needed for "what's my current best" or
  // "celebrate a new one", which is all this sprint's Personal Records page
  // does.
  @@unique([userId, exerciseId, type])
  @@index([userId])
  @@map("personal_records")
}

// ---------------------------------------------------------------------------
// Shared synchronization / idempotency system (Build Session 2)
// ---------------------------------------------------------------------------
// One reusable idempotency ledger for every offline-capable mutation across
// features (workout sets, plans, substitutions today; nutrition entries as
// of this same session) rather than a bespoke table per feature. A client
// generates `idempotencyKey` once per logical mutation (typically a UUID
// stored alongside the local record) and resends the same key on every
// retry; `IdempotencyService` (services/api/src/common/idempotency) turns
// that into "run exactly once, replay the same result on any retry" for
// whichever endpoints opt in. See packages/docs/build-session-2.md for the
// conflict policy this implements.
enum SyncOperationStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model SyncOperation {
  id              String              @id @default(uuid())
  userId          String
  idempotencyKey  String
  entityType      String
  operationType   String
  localEntityId   String?
  clientCreatedAt DateTime?
  payloadVersion  Int                 @default(1)
  status          SyncOperationStatus @default(PROCESSING)
  resultEntityId  String?
  // The exact response body returned the first time this key was
  // processed, so a retry replays byte-for-byte instead of recomputing
  // (and potentially disagreeing with) the original result.
  resultPayload   Json?
  errorMessage    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Enforces "at most one outcome per user per idempotency key" at the
  // database level — the real backstop against duplicate processing, not
  // just application-level checking.
  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@map("sync_operations")
}

// ---------------------------------------------------------------------------
// Nutrition Tracking foundation (Build Session 2)
// ---------------------------------------------------------------------------
// Deliberately no camera/scanner capture yet (see packages/docs/roadmap.md).
// All macro values are stored per `Food`'s own reference serving
// (`servingDescription`/`servingGrams`); `FoodServing` rows are just named,
// user-facing serving options (e.g. "1 cup cooked", "100 g") that resolve to
// a gram quantity for scaling, not a second copy of the macro data.
// `MealEntry` snapshots the computed macros at log time rather than
// re-deriving them from `Food` on every read, specifically so editing or
// archiving a `Food` later never silently rewrites a user's already-logged
// history — the same principle already used for `WorkoutSet`/`PersonalRecord`
// in the Workout Engine.
enum FoodSourceType {
  SEED
  USER
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model Food {
  id                     String         @id @default(uuid())
  // Stable natural key for seeded foods only, so the idempotent seed
  // script can upsert by slug the same way the exercise/workout seed
  // does. Always null for user-created foods — NULLs don't collide under
  // a Postgres unique index, so many custom foods can coexist with none.
  slug                   String?        @unique
  name                   String
  // e.g. a local-language name alongside `name` — informational only.
  alternateName          String?
  brand                  String?
  sourceType             FoodSourceType @default(SEED)
  // Set only for sourceType = USER; a seeded food has no owner and can
  // never be edited or archived by any single user.
  ownerId                String?
  servingDescription     String
  servingGrams           Float?
  caloriesPerServing     Float
  proteinGramsPerServing Float
  carbGramsPerServing    Float
  fatGramsPerServing     Float
  fiberGramsPerServing   Float?
  sodiumMgPerServing     Float?
  // True for essentially all of this session's seed data and every
  // user-entered custom food — this app has no lab-verified nutrition
  // database, so values are always approximate unless a future, real
  // verified source is integrated.
  isEstimated            Boolean        @default(true)
  archivedAt             DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  owner          User?           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  servings       FoodServing[]
  mealEntries    MealEntry[]
  savedMealItems SavedMealItem[]

  @@index([ownerId])
  @@index([name])
  @@map("foods")
}

model FoodServing {
  id        String  @id @default(uuid())
  foodId    String
  label     String
  // Null for a serving unit that isn't gram-convertible (e.g. "1 piece" for
  // a food only ever logged by count) — `MealEntry.loggedByGrams` covers
  // the gram-entry path independently of which serving option was picked.
  grams     Float?
  isDefault Boolean @default(false)

  food           Food            @relation(fields: [foodId], references: [id], onDelete: Cascade)
  mealEntries    MealEntry[]
  savedMealItems SavedMealItem[]

  @@index([foodId])
  @@map("food_servings")
}

model MealEntry {
  id            String   @id @default(uuid())
  userId        String
  foodId        String
  foodServingId String?
  mealType      MealType
  date          DateTime @db.Date
  quantity      Float
  loggedByGrams Boolean  @default(false)
  gramsLogged   Float?
  // Snapshot at log time — see the section comment above.
  calories      Float
  proteinGrams  Float
  carbGrams     Float
  fatGrams      Float
  fiberGrams    Float?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  food        Food         @relation(fields: [foodId], references: [id])
  foodServing FoodServing? @relation(fields: [foodServingId], references: [id])

  @@index([userId, date])
  @@map("meal_entries")
}

model MacroTarget {
  id                 String   @id @default(uuid())
  userId             String   @unique
  calorieTarget      Int
  proteinGramsTarget Int
  carbGramsTarget    Int
  fatGramsTarget     Int
  fiberGramsTarget   Int?
  // True when this row was populated by the safe-default estimator rather
  // than typed in by the user — the Flutter UI uses this to keep showing
  // "estimated" framing until the user edits and implicitly confirms it.
  isEstimatedDefault Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("macro_targets")
}

model WaterEntry {
  id       String   @id @default(uuid())
  userId   String
  date     DateTime @db.Date
  amountMl Int
  loggedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("water_entries")
}

// --- Scenario 1/2/3: sign-in identities and legal acceptance -------------
// See packages/docs/product/user-scenario-bible.md.

// One row per external identity linked to an Ascend account. Every existing
// user is backfilled with an EMAIL row (providerSubject = their user id) so
// email/password login keeps working through the same lookup path once
// Google/Apple linking (Scenario 2/3) goes live. Live Google/Apple OAuth
// itself is NOT implemented this session — no credentials configured — this
// is the durable architecture only.
model AuthIdentity {
  id              String       @id @default(uuid())
  userId          String
  provider        AuthProvider
  // The provider's stable subject identifier for this identity (Google/Apple
  // `sub`, or the user's own id for the EMAIL backfill row). Never the raw
  // provider access token.
  providerSubject String
  providerEmail   String?
  createdAt       DateTime     @default(now())
  lastUsedAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Prevents one external identity (e.g. one Google account) from ever being
  // linked to two different Ascend users.
  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

// A specific published version of a legal document. Content is a
// product-safe draft requiring professional legal review before
// jurisdiction-specific release — see
// packages/docs/product/wellness-ethics-bible.md.
model LegalDocument {
  id          String            @id @default(uuid())
  type        LegalDocumentType
  version     String
  publishedAt DateTime          @default(now())
  content     String

  acceptances LegalAcceptance[]

  @@unique([type, version])
  @@map("legal_documents")
}

model LegalAcceptance {
  id              String   @id @default(uuid())
  userId          String
  legalDocumentId String
  acceptedAt      DateTime @default(now())
  regionCode      String?

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalDocument LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([legalDocumentId])
  @@map("legal_acceptances")
}

// --- Scenario 10: deload recommendation -----------------------------------

// A single deload suggestion surfaced to the user. Never auto-applied —
// always optional, dismissible, and postponable. See
// packages/docs/product/user-scenario-bible.md Scenario 10 for the
// deterministic signals allowed to produce one (no fabricated
// sleep/recovery data).
model DeloadRecommendation {
  id             String    @id @default(uuid())
  userId         String
  suggestedAt    DateTime  @default(now())
  reason         String
  dismissedAt    DateTime?
  postponedUntil DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("deload_recommendations")
}

// --- Saved meals — see packages/docs/product/user-scenario-bible.md
// Part 7 / Founder marathon "Finish Nutrition". A named, reusable group of
// food entries a user can log in one action instead of re-searching each
// item every time. ---

model SavedMeal {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SavedMealItem[]

  @@index([userId])
  @@map("saved_meals")
}

model SavedMealItem {
  id            String  @id @default(uuid())
  savedMealId   String
  foodId        String
  foodServingId String?
  quantity      Float

  savedMeal   SavedMeal    @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
  food        Food         @relation(fields: [foodId], references: [id])
  foodServing FoodServing? @relation(fields: [foodServingId], references: [id])

  @@index([savedMealId])
  @@map("saved_meal_items")
}

// --- Achievements — Founder Scenario 11. Ascend owns the canonical
// cross-platform record; award logic is idempotent via the unique
// (userId, achievementId) pair below (an upsert, never a duplicate
// insert). See packages/docs/product/wellness-ethics-bible.md's
// "Achievement safety" section for the conditions this must never
// reward. ---

enum AchievementCategory {
  WORKOUT
  NUTRITION
  CONSISTENCY
  CARDIO
  RECOVERY
}

model Achievement {
  id          String              @id @default(uuid())
  // Stable key the award-evaluation code matches against (e.g.
  // "first_workout") — never renamed once shipped, since it's the
  // durable identity an external sync (Play Games / Game Center,
  // future) would eventually map to as well.
  key         String              @unique
  title       String
  description String
  iconAsset   String
  category    AchievementCategory
  // Steps needed to "complete" a multi-step achievement (e.g. 10 active
  // days = 10). 1 for a simple one-shot achievement.
  targetSteps Int                 @default(1)
  createdAt   DateTime            @default(now())

  awards AchievementAward[]

  @@map("achievements")
}

model AchievementAward {
  id            String    @id @default(uuid())
  userId        String
  achievementId String
  progress      Int       @default(0)
  // Null until targetSteps is reached — a row can exist purely to track
  // in-progress steps toward a multi-step achievement without having
  // "earned" it yet.
  earnedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  // The idempotency guarantee: evaluating the same trigger twice for a
  // user upserts this one row rather than creating a duplicate award.
  @@unique([userId, achievementId])
  @@index([userId])
  @@map("achievement_awards")
}

// --- GPS cardio — Founder Scenario 12. This session implements manual/
// summary cardio logging (duration, distance, activity type) with the
// privacy fields a future live-GPS route recorder will need; it does not
// implement live on-device GPS tracking — that requires platform location
// permission plumbing (geolocator/permission_handler) that can't be
// exercised or verified in this sandboxed build environment. See
// packages/docs/product/parking-lot.md. ---

enum CardioActivityType {
  WALK
  JOG
  RUN
  SPRINT
  CYCLE
  HIKE
  WHEELCHAIR
  OTHER
}

// Distinguishes how a session's summary numbers were produced — matters
// for privacy (only LIVE_GPS ever has route points to store) and, later,
// for Rankings anti-cheat (a manual entry must never be silently treated
// as GPS-verified). See packages/docs/product/user-scenario-bible.md
// Scenario 12/25's manual-vs-verified distinction.
enum CardioSessionSource {
  MANUAL
  LIVE_GPS
  WEARABLE
}

model CardioSession {
  id                  String              @id @default(uuid())
  userId              String
  activityType        CardioActivityType
  source              CardioSessionSource @default(MANUAL)
  startedAt           DateTime
  durationSeconds     Int
  distanceMeters      Float?
  elevationGainMeters Float?
  // A clear-estimate-labeled figure, never presented as precise — see
  // wellness-ethics-bible.md's "explain uncertainty" principle.
  estimatedCalories   Float?
  // Coarse, user-entered region tag (e.g. "Quezon City") — never exact
  // coordinates. Manual tags must never imply a measured/fabricated
  // distance; distanceMeters stays null unless the user actually entered
  // one.
  regionLabel         String?
  // Private-by-default route/location visibility, independent toggles
  // per Scenario 12's "hide start / end / route" requirement.
  hideRoute           Boolean             @default(true)
  hideStartLocation   Boolean             @default(true)
  hideEndLocation     Boolean             @default(true)
  // Google-style encoded polyline (see common/geo/polyline.util.ts) of a
  // LIVE_GPS session's route, already endpoint-trimmed per
  // hideStartLocation/hideEndLocation and entirely absent when
  // hideRoute is true — trimmed/discarded points are never persisted in
  // the first place, not merely filtered at read time. Null for MANUAL
  // sessions (no coordinates were ever recorded) and for any session
  // whose owner chose hideRoute.
  encodedRoute        String?             @db.Text
  // Point count of the route actually stored (post-trimming), kept
  // alongside encodedRoute for display/debugging without decoding it.
  routePointCount     Int?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("cardio_sessions")
}
