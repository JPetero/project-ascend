# Project Ascend — staging deployment bundle env file (S15 Part 12)
#
#   cp .env.staging.template .env.staging   # then fill in every value below
#   docker compose --env-file .env.staging -f docker-compose.staging.yml up -d
#
# NEVER commit the filled-in .env.staging. It is gitignored in this
# directory; keep it readable only by the deploy user (chmod 600).
#
# Every variable here without a default is enforced by the compose file
# itself — a missing value fails the deploy loudly instead of silently
# substituting something unsafe.
#
# The full explanation of each application variable is
# packages/docs/release/staging-config-contract.md.

# ---- Images -----------------------------------------------------------
# Your GitHub user/org, lowercased (GHCR rejects uppercase).
GHCR_OWNER=your-github-username

# Pin a commit SHA, not "main". A SHA makes redeploys reproducible and
# makes rollback a real target rather than "whatever main pointed at
# yesterday". Find one in the Backend CI run summary for the commit you
# want to deploy.
IMAGE_TAG=0000000000000000000000000000000000000000

# ---- Database ---------------------------------------------------------
# Used by the postgres container to initialise itself.
POSTGRES_USER=ascend
POSTGRES_PASSWORD=
POSTGRES_DB=ascend_staging

# Used by the api and migrate containers to connect. The host must be
# `postgres` — the compose service name on the internal network, not
# localhost (which inside a container means the container itself).
# Must match the three values above.
DATABASE_URL=postgresql://ascend:CHANGE_ME@postgres:5432/ascend_staging?schema=public

# ---- Secrets ----------------------------------------------------------
# Generate each separately: openssl rand -base64 48
# 32+ chars, different from each other, and different from production's.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Public identity --------------------------------------------------
# The real https:// URL the API is reachable at, through the reverse
# proxy. Password-reset and email-verification links are built from it.
APP_PUBLIC_URL=https://staging-api.your-domain.example

# Explicit allowlist of origins permitted to call the API. Never "*".
# Typically the staging admin app's origin.
CORS_ORIGIN=https://staging-admin.your-domain.example

# ---- Optional ---------------------------------------------------------
# Every variable below is optional and empty is a valid Stage B value.
# See release/staging-config-contract.md before setting any of them —
# in particular, leaving EMAIL_PROVIDER=console means testers cannot
# complete password reset or email verification on a real phone.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Project Ascend (Staging)

MEDIA_STORAGE_PROVIDER=local
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_PUBLIC_BASE_URL=
